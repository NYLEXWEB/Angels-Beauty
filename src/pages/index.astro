---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ServicesShowcase from '../components/ServicesShowcase';
import BridalHighlight from '../components/BridalHighlight.astro';
import GallerySection from '../components/GallerySection.astro';
import InstagramSection from '../components/InstagramSection.astro';
import ReviewsCarousel from '../components/ReviewsCarousel';
import BookingForm from '../components/BookingForm';
import FAQSection, { HOME_FAQS } from '../components/FAQSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';
---

<Layout 
  title="Best Bridal Makeup in Wayanad | Angels Beauty Parlour & Studio"
  description="Wayanad's signature destination for bespoke bridal makeup, HD airbrush beauty, Korean glass skin facials and hair transformations at PP Building, Mananthavady. Open daily 9 AM – 8 PM."
  keywords="bridal makeup wayanad, best beauty parlour in mananthavady, bridal studio mananthavady, HD bridal makeup kerala, korean glass skin facial wayanad, hair botox mananthavady, nanoplastia wayanad, wedding makeup artist wayanad"
  faqs={HOME_FAQS}
>
  <Header />
  
  <main class="min-h-screen w-full max-w-full">
    <!-- 1. Hero Section -->
    <Hero />

    <!-- 2. Intro / About Section -->
    <About />

    <!-- 3. Services Showcase (The Showpiece) -->
    <ServicesShowcase client:visible />

    <!-- 4. Bridal Highlight Teaser -->
    <BridalHighlight />

    <!-- 5. Studio Gallery with Lightbox -->
    <GallerySection />

    <!-- 6. Instagram Section with Real Client Photos -->
    <InstagramSection />

    <!-- 7. Google Reviews Carousel -->
    <ReviewsCarousel client:visible />

    <!-- 8. Interactive Booking Form -->
    <BookingForm client:visible />

    <!-- 9. Frequently Asked Questions (Local SEO & Rich Snippets) -->
    <FAQSection />

    <!-- 10. Contact, Address & Google Maps Location -->
    <ContactSection />
  </main>

  <!-- Footer -->
  <Footer />

  <!-- Floating Action Buttons (WhatsApp & Instagram) -->
  <FloatingActions />
</Layout>
