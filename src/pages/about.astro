---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import About from '../components/About.astro';
import ContactSection from '../components/ContactSection.astro';
import FloatingActions from '../components/FloatingActions';
import { SITE_CONFIG } from '../config/site';
---

<Layout 
  title="About Our Studio | Angels Beauty Parlour & Bridal Studio, Mananthavady"
  description="Discover Angels Beauty Parlour and Bridal Studio in Mananthavady, Wayanad. Certified bridal artists, private bridal dressing room, and tranquil hygiene-certified aesthetic bays."
>
  <Header />

  <main class="min-h-screen bg-canvas overflow-x-clip pt-24 sm:pt-28">
    
    <!-- Page Hero Banner -->
    <section class="py-12 sm:py-16 lg:py-20 bg-surface border-b border-gold-border/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Minimalist Aesthetic Back Button -->
        <a 
          href="/" 
          onclick="if (window.history.length > 1) { window.history.back(); return false; }"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-sans font-medium text-charcoal/80 bg-white/95 hover:bg-white border border-black/[0.08] shadow-2xs hover:shadow-xs transition-all active:scale-97 group w-fit mb-5 cursor-pointer"
          aria-label="Back to Previous Page"
        >
          <svg class="w-3.5 h-3.5 text-gold-deep transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          <span>Back</span>
        </a>

        <div class="max-w-3xl space-y-3 sm:space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-black/[0.08] bg-white/90 backdrop-blur-md text-charcoal shadow-2xs max-w-fit">
            <span class="w-2 h-2 rounded-full bg-gold-deep shrink-0"></span>
            <span class="text-[11px] sm:text-xs font-sans font-medium text-charcoal/90 tracking-tight">
              Mananthavady, Wayanad · Est. 2018
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-charcoal leading-[1.1] tracking-[-0.035em]">
            A Tranquil Haven for <span class="italic font-normal text-gold-deep">Bridal Grace</span> & Restorative Beauty.
          </h1>

          <p class="text-sm sm:text-base lg:text-lg text-muted font-sans leading-relaxed tracking-tight max-w-2xl">
            Founded with a vision to bring unhurried, royal bridal artistry and advanced international skincare therapies to Wayanad, Angels Beauty Parlour has grown into the region's most trusted sanctuary for brides and families.
          </p>
        </div>
      </div>
    </section>

    <!-- Main About Component -->
    <About />

    <!-- Studio Pillars & Commitment -->
    <section class="py-16 sm:py-24 bg-canvas border-b border-gold-border/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16 space-y-2">
          <span class="text-[11px] sm:text-xs font-sans font-semibold tracking-[0.25em] uppercase text-gold-deep block">
            Our Core Standards
          </span>
          <h2 class="text-2xl sm:text-4xl font-light text-charcoal tracking-tight">
            Why Wayanad Brides Trust Angels
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
          <div class="p-6 sm:p-8 rounded-3xl bg-surface border border-gold-border/60 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-2xl bg-gold/15 flex items-center justify-center text-gold-deep font-semibold text-sm">
              01
            </div>
            <h3 class="font-serif text-xl text-charcoal font-medium">Private Bridal Suite</h3>
            <p class="text-xs sm:text-sm text-muted font-sans leading-relaxed">
              An exclusive, air-conditioned sanctuary with full-length mirrors, saree draping lounges, and tranquil ambiance devoted solely to you and your bridal entourage.
            </p>
          </div>

          <div class="p-6 sm:p-8 rounded-3xl bg-surface border border-gold-border/60 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-2xl bg-gold/15 flex items-center justify-center text-gold-deep font-semibold text-sm">
              02
            </div>
            <h3 class="font-serif text-xl text-charcoal font-medium">Strict Hospital-Grade Hygiene</h3>
            <p class="text-xs sm:text-sm text-muted font-sans leading-relaxed">
              Autoclaved and sanitized tools, single-use disposables, and clinically verified skincare products ensure total safety and skin purity for every treatment.
            </p>
          </div>

          <div class="p-6 sm:p-8 rounded-3xl bg-surface border border-gold-border/60 shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-2xl bg-gold/15 flex items-center justify-center text-gold-deep font-semibold text-sm">
              03
            </div>
            <h3 class="font-serif text-xl text-charcoal font-medium">Certified Artistry & Precision</h3>
            <p class="text-xs sm:text-sm text-muted font-sans leading-relaxed">
              Certified master artists specializing in HD, Airbrush, and Glass Skin techniques that stay flawless and camera-ready under high-definition wedding lenses.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Studio Location & Connect -->
    <ContactSection />

  </main>

  <Footer />
  <FloatingActions client:idle />
</Layout>
