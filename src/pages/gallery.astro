---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GallerySection from '../components/GallerySection.astro';
import InstagramSection from '../components/InstagramSection.astro';
import FloatingActions from '../components/FloatingActions';
---

<Layout 
  title="Real Brides & Studio Gallery | Angels Beauty Parlour, Wayanad"
  description="View our portfolio of real brides styled in Wayanad: South Indian silks, Christian gowns, reception lehengas, and behind-the-scenes Reels at Angels Beauty Parlour."
>
  <Header />

  <main class="min-h-screen bg-canvas overflow-x-clip pt-24 sm:pt-28">
    
    <!-- Page Hero Banner -->
    <section class="py-12 sm:py-16 lg:py-20 bg-surface border-b border-gold-border/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Minimalist Aesthetic Back Button -->
        <a 
          href="/" 
          onclick="if (window.history.length > 1) { window.history.back(); return false; }"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-sans font-medium text-charcoal/80 bg-white/95 hover:bg-white border border-black/[0.08] shadow-2xs hover:shadow-xs transition-all active:scale-97 group w-fit mb-5 cursor-pointer"
          aria-label="Back to Previous Page"
        >
          <svg class="w-3.5 h-3.5 text-gold-deep transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          <span>Back</span>
        </a>

        <div class="max-w-3xl space-y-3 sm:space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-black/[0.08] bg-white/90 backdrop-blur-md text-charcoal shadow-2xs max-w-fit">
            <span class="w-2 h-2 rounded-full bg-gold-deep shrink-0"></span>
            <span class="text-[11px] sm:text-xs font-sans font-medium text-charcoal/90 tracking-tight">
              Real Brides · 100% Authentic Client Photography
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-charcoal leading-[1.1] tracking-[-0.035em]">
            Bridal Couture & <span class="italic font-normal text-gold-deep">Artistry Portfolio</span>.
          </h1>

          <p class="text-sm sm:text-base lg:text-lg text-muted font-sans leading-relaxed tracking-tight max-w-2xl">
            Explore authentic wedding celebrations styled by Angels Beauty Studio in Mananthavady — from heirloom Kanchipuram silks to radiant Christian lace gowns and reception lehengas.
          </p>

          <div class="flex items-center gap-3 pt-2">
            <a 
              href="/booking" 
              class="inline-flex items-center justify-center py-2.5 px-6 rounded-full text-xs font-semibold tracking-wider uppercase bg-gold hover:bg-gold-hover text-charcoal shadow-xs transition-all active:scale-97"
            >
              Reserve Your Wedding Date
            </a>
            <a 
              href="/bridal" 
              class="inline-flex items-center justify-center py-2.5 px-6 rounded-full text-xs font-semibold tracking-wider uppercase border border-gold-border hover:bg-canvas text-charcoal transition-all active:scale-97"
            >
              Explore 6 Packages
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 15 Photos Gallery Component (Pure Photography - Zero Writings on Photos) -->
    <GallerySection />

    <!-- Instagram Video Reels Section -->
    <InstagramSection />

  </main>

  <Footer />
  <FloatingActions client:idle />
</Layout>
