---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
import BookingForm from '../components/BookingForm';
import FloatingActions from '../components/FloatingActions.astro';
---

<Layout 
  title="Contact & Location | Angels Beauty Parlour Mananthavady, Wayanad"
  description="Visit Angels Beauty Parlour at PP Building, Near St Joseph's Hospital, Mananthavady, Wayanad. Call or WhatsApp +91 8606 248 992. Open 7 days a week, 9 AM – 8 PM."
  keywords="angels beauty parlour contact, beauty parlour mananthavady phone number, angels beauty parlour address wayanad, salon near st joseph hospital mananthavady"
  breadcrumbs={[
    { name: "Contact & Location", url: "/contact" }
  ]}
>
  <Header />

  <main class="min-h-screen bg-canvas overflow-x-clip pt-24 sm:pt-28">
    
    <!-- Page Hero Banner -->
    <section class="py-12 sm:py-16 lg:py-20 bg-surface border-b border-gold-border/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Minimalist Aesthetic Back Button -->
        <a 
          href="/" 
          onclick="if (window.history.length > 1) { window.history.back(); return false; }"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-sans font-medium text-charcoal/80 bg-white/95 hover:bg-white border border-black/[0.08] shadow-2xs hover:shadow-xs transition-all active:scale-97 group w-fit mb-5 cursor-pointer"
          aria-label="Back to Previous Page"
        >
          <svg class="w-3.5 h-3.5 text-gold-deep transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          <span>Back</span>
        </a>

        <div class="max-w-3xl space-y-3 sm:space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-black/[0.08] bg-white/90 backdrop-blur-md text-charcoal shadow-2xs max-w-fit">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
            <span class="text-[11px] sm:text-xs font-sans font-medium text-charcoal/90 tracking-tight">
              Open Daily · 9:00 AM – 8:00 PM · Dedicated Parking
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-light text-charcoal leading-[1.1] tracking-[-0.035em]">
            Visit Our Studio in <span class="italic font-normal text-gold-deep">Mananthavady</span>.
          </h1>

          <p class="text-sm sm:text-base lg:text-lg text-muted font-sans leading-relaxed tracking-tight max-w-2xl">
            Conveniently located at PP Building, directly opposite St. Joseph’s Hospital in the heart of Mananthavady, Wayanad. We look forward to welcoming you.
          </p>
        </div>
      </div>
    </section>

    <!-- Studio Contact, Map & Directions -->
    <ContactSection />

    <!-- Appointment Booking Form -->
    <BookingForm client:visible />

  </main>

  <Footer />
  <FloatingActions />
</Layout>
