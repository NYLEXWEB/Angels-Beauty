---
import { SITE_CONFIG } from '../config/site';

const INSTA_POSTS = [
  {
    id: "post-1",
    image: "/images/bridal-church.jpg",
    location: "St. Joseph's Church, Mananthavady",
    likes: "482",
    likedBy: "keralabrides",
    caption: "Graceful church wedding bride styled with our bespoke UHD bridal package & fresh floral veil. Timeless perfection that stays radiant all ceremony long. ✨🕊️",
    tags: "#WayanadBrides #AngelsBridal #KeralaWedding #UHDBridal",
    commentsCount: "38",
    timeAgo: "2 DAYS AGO",
    isReel: true
  },
  {
    id: "post-2",
    image: "/images/bridal-room.jpg",
    location: "Angels Bridal Studio, Mananthavady",
    likes: "349",
    likedBy: "wayanad_weddings",
    caption: "Step into your private bridal chamber at PP Building, Mananthavady. Quiet, hygienic, and devoted solely to your big day preparations. 👑🤍",
    tags: "#BridalSuite #PrivateLounge #WayanadSalon #AngelsBeauty",
    commentsCount: "24",
    timeAgo: "4 DAYS AGO",
    isReel: false
  },
  {
    id: "post-3",
    image: "/images/skin-hair-lounge.jpg",
    location: "PP Building, Mananthavady",
    likes: "412",
    likedBy: "beauty_kerala",
    caption: "Korean Glass Skin Facial sessions in session. Multi-step hydration for that porcelain lit-from-within glow without heavy filters. ✨🌸",
    tags: "#GlassSkin #KoreanFacial #WayanadBeauty #SkinCareRituals",
    commentsCount: "29",
    timeAgo: "6 DAYS AGO",
    isReel: true
  }
];
---

<section class="py-14 sm:py-20 md:py-28 bg-surface border-b border-gold-border/30 overflow-x-clip">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Profile Header Card (Instagram Official Style) -->
    <div class="p-4 sm:p-7 rounded-2xl sm:rounded-3xl bg-canvas border border-gold-border/70 shadow-xs mb-10 sm:mb-16">
      <div class="flex flex-col sm:flex-row items-center sm:items-start justify-between gap-4 sm:gap-6">
        
        <!-- Avatar + Profile Meta -->
        <div class="flex flex-row items-center sm:items-start gap-3.5 sm:gap-5 w-full sm:w-auto">
          <!-- Gradient Ring Avatar -->
          <div class="relative p-0.5 sm:p-1 rounded-full bg-gradient-to-tr from-[#FD1D1D] via-[#E1306C] to-[#833AB4] shadow-md shrink-0">
            <div class="w-14 h-14 sm:w-18 sm:h-18 rounded-full overflow-hidden bg-white p-0.5">
              <img 
                src="/images/logo.png" 
                alt="Angels Beauty Parlour Instagram Avatar" 
                class="w-full h-full object-cover rounded-full"
                width="72"
                height="72"
                loading="lazy"
              />
            </div>
          </div>

          <div class="space-y-1">
            <div class="flex items-center gap-1.5">
              <h3 class="font-serif text-lg sm:text-2xl text-charcoal font-semibold leading-tight">
                angels_beauty__parlour
              </h3>
              <span class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full bg-blue-500 text-white flex items-center justify-center text-[9px] shrink-0 font-bold">
                ✓
              </span>
            </div>
            <p class="text-[11px] sm:text-xs font-sans text-charcoal font-medium">
              Angels Beauty Parlour and Bridal Studio
            </p>
            <p class="text-[11px] sm:text-xs text-muted max-w-md font-sans leading-relaxed">
              Bridal Studio & Beauty Salon • PP Building, Near St Joseph’s Hospital, Mananthavady, Wayanad
            </p>
          </div>
        </div>

        <!-- Follow CTA Button -->
        <a 
          href={SITE_CONFIG.social.instagramUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full text-xs font-sans font-semibold uppercase tracking-wider text-white bg-gradient-to-r from-[#833AB4] via-[#E1306C] to-[#FD1D1D] hover:opacity-95 shadow-xs transition-all active:scale-98"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Follow on Instagram</span>
        </a>

      </div>
    </div>

    <!-- 3 Complete Instagram Post Cards (Pixel-Perfect Instagram UI) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {INSTA_POSTS.map((post) => (
        <article class="rounded-2xl sm:rounded-3xl bg-canvas border border-gold-border/70 shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between group">
          
          <div>
            <!-- 1. Post Header: Avatar, Username, Location, 3-dots -->
            <div class="p-3.5 sm:p-4 flex items-center justify-between border-b border-gold-border/20">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full p-0.5 bg-gradient-to-tr from-[#FD1D1D] via-[#E1306C] to-[#833AB4] shrink-0">
                  <div class="w-full h-full rounded-full bg-white overflow-hidden p-0.5">
                    <img src="/images/logo.png" alt="Avatar" class="w-full h-full object-cover rounded-full" />
                  </div>
                </div>
                <div>
                  <div class="flex items-center gap-1">
                    <span class="text-xs font-semibold text-charcoal font-sans">angels_beauty__parlour</span>
                    <span class="text-[9px] text-blue-500">✓</span>
                  </div>
                  <p class="text-[10px] text-muted font-sans leading-none mt-0.5">{post.location}</p>
                </div>
              </div>

              <!-- 3-dots menu button -->
              <button type="button" class="text-charcoal/60 hover:text-charcoal p-1" aria-label="More options">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="1.5"/>
                  <circle cx="6" cy="12" r="1.5"/>
                  <circle cx="18" cy="12" r="1.5"/>
                </svg>
              </button>
            </div>

            <!-- 2. Post Media (Image / Reel) with hover zoom -->
            <a 
              href={SITE_CONFIG.social.instagramUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="relative aspect-[4/5] block overflow-hidden bg-surface"
              aria-label="View on Instagram"
            >
              <img 
                src={post.image} 
                alt="Instagram post media" 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />

              {/* Reel Watermark Badge */}
              {post.isReel && (
                <div class="absolute top-3 right-3 px-2 py-1 rounded-md bg-charcoal/70 backdrop-blur-xs text-white text-[10px] font-sans font-medium flex items-center gap-1">
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <span>Reel</span>
                </div>
              )}
            </a>

            <!-- 3. Action Bar: Like, Comment, Share, Repost, Save -->
            <div class="p-3.5 sm:p-4 pb-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3.5 text-charcoal">
                  <!-- Like Heart -->
                  <button type="button" class="hover:text-red-500 transition-colors" aria-label="Like post">
                    <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                  </button>

                  <!-- Comment Speech Bubble -->
                  <button type="button" class="hover:text-gold-deep transition-colors" aria-label="Comment">
                    <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.54 1.106.31 1.664l-.79 1.916c-.2.487.27.994.778.834l2.257-.71a1.47 1.47 0 011.085.12c1.01.604 2.147.946 3.387.946z" />
                    </svg>
                  </button>

                  <!-- Share Paper Plane -->
                  <button type="button" class="hover:text-gold-deep transition-colors" aria-label="Share">
                    <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                    </svg>
                  </button>

                  <!-- Repost Icon -->
                  <button type="button" class="hover:text-emerald-600 transition-colors" aria-label="Repost">
                    <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-4.142-3.358-7.5-7.5-7.5S4.5 7.858 4.5 12m15 0l-3-3m3 3l-3 3M4.5 12l3-3m-3 3l3 3" />
                    </svg>
                  </button>
                </div>

                <!-- Bookmark Save Ribbon -->
                <button type="button" class="hover:text-gold-deep transition-colors" aria-label="Save post">
                  <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                  </svg>
                </button>
              </div>

              <!-- Likes Count -->
              <div class="mt-2 text-xs font-sans text-charcoal font-semibold">
                Liked by <span class="font-bold">{post.likedBy}</span> and <span class="font-bold">{post.likes} others</span>
              </div>

              <!-- Caption -->
              <div class="mt-1.5 text-xs font-sans text-charcoal leading-relaxed">
                <span class="font-semibold mr-1.5">angels_beauty__parlour</span>
                <span class="text-charcoal/90">{post.caption}</span>
                <span class="block text-gold-deep font-medium mt-1 text-[11px]">{post.tags}</span>
              </div>

              <!-- Comments line & Timestamp -->
              <p class="mt-2 text-[11px] text-muted font-sans">
                View all {post.commentsCount} comments
              </p>
              <p class="mt-0.5 text-[9px] font-sans font-medium uppercase tracking-wider text-subtle">
                {post.timeAgo}
              </p>
            </div>
          </div>

          <!-- Bottom Action: Open in Instagram -->
          <div class="p-3 sm:p-4 pt-2 border-t border-gold-border/20">
            <a 
              href={SITE_CONFIG.social.instagramUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full py-2 px-3 rounded-xl border border-gold-border/60 hover:bg-gold/15 text-[11px] font-sans font-semibold tracking-wide text-charcoal flex items-center justify-center gap-1.5 transition-colors"
            >
              <span>Open on Instagram</span>
              <svg class="w-3 h-3 text-gold-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>

        </article>
      ))}
    </div>

    <!-- Link out banner -->
    <div class="mt-10 sm:mt-12 text-center">
      <a 
        href={SITE_CONFIG.social.instagramUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs font-sans font-semibold tracking-wider uppercase text-charcoal hover:text-gold-deep transition-colors border-b border-gold-deep pb-0.5"
      >
        <span>Explore daily bridal transformations & client reels on @angels_beauty__parlour</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>

  </div>
</section>
