---
import { SITE_CONFIG } from '../config/site';

const REELS = [
  {
    id: "reel-1",
    videoSrc: "/videos/angels-reel-1.mp4",
    likes: "1,428",
    audio: "Original Audio · Angels Bridal Couture",
    location: "Mananthavady, Wayanad"
  },
  {
    id: "reel-2",
    videoSrc: "/videos/angels-reel-2.mp4",
    likes: "1,184",
    audio: "Original Audio · Angels Beauty Studio",
    location: "Mananthavady, Wayanad"
  },
  {
    id: "reel-3",
    videoSrc: "/videos/angels-reel-3.mp4",
    likes: "2,045",
    audio: "Original Audio · Hair Transformations",
    location: "Mananthavady, Wayanad"
  },
  {
    id: "reel-4",
    videoSrc: "/videos/angels-reel-4.mp4",
    likes: "1,756",
    audio: "Original Audio · Bridal Studio Moments",
    location: "Mananthavady, Wayanad"
  },
  {
    id: "reel-5",
    videoSrc: "/videos/VID_20261124_143321_853.mp4",
    likes: "2,310",
    audio: "Original Audio · Glowing Bride Reveal",
    location: "Mananthavady, Wayanad"
  },
  {
    id: "reel-6",
    videoSrc: "/videos/VID_20261124_143511_546.mp4",
    likes: "1,940",
    audio: "Original Audio · Haute Bridal Elegance",
    location: "Mananthavady, Wayanad"
  },
  {
    id: "reel-7",
    videoSrc: "/videos/VID_20261124_143611_495_1.mp4",
    likes: "2,185",
    audio: "Original Audio · Glass Skin Transformation",
    location: "Mananthavady, Wayanad"
  },
  {
    id: "reel-8",
    videoSrc: "/videos/VID_20261124_144422_092.mp4",
    likes: "3,420",
    audio: "Original Audio · Signature Reception Look",
    location: "Mananthavady, Wayanad"
  },
  {
    id: "reel-9",
    videoSrc: "/videos/VID_20261124_144509_481.mp4",
    likes: "1,875",
    audio: "Original Audio · Timeless Bridal Artistry",
    location: "Mananthavady, Wayanad"
  }
];
---

<section id="instagram" class="py-16 sm:py-24 lg:py-32 bg-surface border-b border-gold-border/30 overflow-x-clip relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Minimalist Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
      <div class="max-w-2xl space-y-2 sm:space-y-3">
        <span class="text-[11px] sm:text-xs font-sans font-semibold tracking-[0.25em] uppercase text-gold-deep block">
          Instagram Reels · Studio Life
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-light text-charcoal tracking-[-0.03em] leading-tight">
          Watch Our Real Transformations
        </h2>
        <p class="text-muted text-xs sm:text-base font-sans leading-relaxed max-w-xl">
          Behind-the-scenes artistry, radiant bridal reveals, and skincare moments captured live at our Mananthavady studio.
        </p>
      </div>

      <!-- Instagram Official Follow Button -->
      <a 
        href={SITE_CONFIG.social.instagramUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-full text-xs font-sans font-semibold uppercase tracking-wider text-white bg-gradient-to-r from-[#833AB4] via-[#E1306C] to-[#FD1D1D] hover:opacity-95 shadow-xs transition-all active:scale-98 shrink-0 max-w-fit"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span>@angels_beauty__parlour</span>
      </a>
    </div>

    <!-- Instagram Video Reel Frames:
         On Mobile: Smooth Stacking Cards (each video fixes at top, and next video glides over and fixes on top)
         On Tablet: 2-column clean responsive grid
         On Desktop: Sleek 3-column side-by-side grid (3x3 = 9 cards)
    -->
    <div class="flex flex-col md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 max-w-7xl mx-auto relative pb-12 sm:pb-16">
      {REELS.map((reel, index) => {
        const mobileTop = 76;
        const zIndex = 10 + index * 2;
        return (
          <div 
            class="reel-wrapper mobile-stack-card sticky md:static md:top-auto mb-28 sm:mb-40 md:mb-0 last:mb-0 w-full transition-transform duration-300 md:!z-auto"
            style={`top: ${mobileTop}px; z-index: ${zIndex};`}
          >
            <div class="reel-container relative aspect-[9/16] w-full max-w-[320px] xs:max-w-[340px] sm:max-w-[360px] md:max-w-none mx-auto rounded-[26px] sm:rounded-[32px] overflow-hidden bg-black shadow-[0_16px_40px_-10px_rgba(0,0,0,0.7)] border-[4px] sm:border-[5px] border-charcoal/90 select-none group transition-all duration-300 hover:shadow-gold/20">
            
            <!-- Video Element (Played by IntersectionObserver when in view) -->
            <video 
              class="reel-video absolute inset-0 w-full h-full object-cover cursor-pointer"
              src={reel.videoSrc}
              loop
              muted
              playsinline
              preload="metadata"
            ></video>

            <!-- Play/Pause Indicator (Flashes briefly on click) -->
            <div class="reel-play-indicator absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-200 z-30">
              <div class="w-16 h-16 rounded-full bg-black/60 backdrop-blur-md flex items-center justify-center text-white shadow-xl">
                <svg class="play-icon w-8 h-8 fill-current translate-x-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <svg class="pause-icon w-8 h-8 fill-current hidden" viewBox="0 0 24 24">
                  <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                </svg>
              </div>
            </div>

            <!-- Top Header Bar inside Reel -->
            <div class="absolute top-0 inset-x-0 p-3.5 sm:p-4 pt-4 sm:pt-5 z-20 flex items-center justify-between bg-gradient-to-b from-black/85 via-black/40 to-transparent pointer-events-auto">
              <a 
                href={SITE_CONFIG.social.instagramUrl}
                target="_blank"
                rel="noopener noreferrer" 
                class="flex items-center gap-2 hover:opacity-90 transition-opacity"
              >
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full p-0.5 bg-gradient-to-tr from-[#FD1D1D] via-[#E1306C] to-[#833AB4] shrink-0">
                  <img src="/images/logo.png" alt="Angels" class="w-full h-full object-cover rounded-full bg-white p-0.5" width="36" height="36" loading="lazy" decoding="async" />
                </div>
                <div>
                  <div class="flex items-center gap-1">
                    <span class="text-[11px] sm:text-xs font-semibold text-white font-sans tracking-tight">angels_beauty__parlour</span>
                    <span class="w-3.5 h-3.5 rounded-full bg-blue-500 text-white flex items-center justify-center text-[8px] font-bold">✓</span>
                  </div>
                  <span class="text-[9px] sm:text-[10px] text-white/80 font-sans block leading-none mt-0.5">{reel.location}</span>
                </div>
              </a>

              <!-- Action Controls: Fullscreen / Theater + Sound -->
              <div class="flex items-center gap-1.5 shrink-0">
                <!-- Fullscreen / Expand Button (Minimalist Desktop Theater View) -->
                <button 
                  type="button" 
                  class="reel-expand-btn w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/45 hover:bg-black/75 backdrop-blur-md text-white flex items-center justify-center transition-all cursor-pointer border border-white/20 active:scale-95"
                  data-video-src={reel.videoSrc}
                  data-audio={reel.audio}
                  data-location={reel.location}
                  aria-label="Watch Video Fullscreen"
                  title="Watch Video Fullscreen"
                >
                  <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                  </svg>
                </button>

                <!-- Sound Mute/Unmute Control -->
                <button 
                  type="button" 
                  class="reel-sound-btn w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/45 hover:bg-black/75 backdrop-blur-md text-white flex items-center justify-center transition-all cursor-pointer border border-white/20 active:scale-95"
                  aria-label="Toggle Audio Sound"
                  title="Click to Unmute / Mute"
                >
                  <!-- Muted Icon (Default) -->
                  <svg class="sound-muted-icon w-3.5 h-3.5 sm:w-4 sm:h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
                  </svg>
                  <!-- Unmuted Audio Icon (Active) -->
                  <svg class="sound-active-icon w-3.5 h-3.5 sm:w-4 sm:h-4 text-gold hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Floating Right Action Bar: Like, Share, Save -->
            <div class="absolute right-3.5 bottom-16 z-20 flex flex-col items-center gap-4 text-white pointer-events-auto">
              
              <!-- 1. Like Button (Interactive Heart) -->
              <button 
                type="button" 
                class="reel-like-btn flex flex-col items-center gap-1 group/btn cursor-pointer transition-transform active:scale-125"
                aria-label="Like this reel"
              >
                <div class="w-10 h-10 rounded-full bg-black/45 hover:bg-black/70 backdrop-blur-md flex items-center justify-center transition-colors border border-white/15">
                  <svg class="like-icon w-5 h-5 fill-none stroke-current transition-all" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                  </svg>
                </div>
                <span class="like-count text-[11px] font-sans font-medium text-white/90">{reel.likes}</span>
              </button>

              <!-- 2. Share Button (Paper Plane) -->
              <button 
                type="button" 
                class="reel-share-btn flex flex-col items-center gap-1 group/btn cursor-pointer transition-transform active:scale-110"
                aria-label="Share this reel"
                title="Share"
              >
                <div class="w-10 h-10 rounded-full bg-black/45 hover:bg-black/70 backdrop-blur-md flex items-center justify-center transition-colors border border-white/15">
                  <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                  </svg>
                </div>
                <span class="text-[11px] font-sans font-medium text-white/90">Share</span>
              </button>

              <!-- 3. Save / Bookmark Button -->
              <button 
                type="button" 
                class="reel-save-btn flex flex-col items-center gap-1 group/btn cursor-pointer transition-transform active:scale-110"
                aria-label="Save this reel"
                title="Save"
              >
                <div class="w-10 h-10 rounded-full bg-black/45 hover:bg-black/70 backdrop-blur-md flex items-center justify-center transition-colors border border-white/15">
                  <svg class="save-icon w-5 h-5 fill-none stroke-current transition-all" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                  </svg>
                </div>
                <span class="save-text text-[11px] font-sans font-medium text-white/90">Save</span>
              </button>

            </div>

            <!-- Bottom Minimalist Audio Info (ZERO UNWANTED WRITINGS / NO HEAVY DESCRIPTIONS) -->
            <div class="absolute bottom-0 inset-x-0 p-4 pb-5 z-20 bg-gradient-to-t from-black/85 via-black/40 to-transparent pointer-events-auto">
              <div class="flex items-center gap-2 max-w-[70%]">
                <span class="w-2 h-2 rounded-full bg-gold animate-pulse shrink-0"></span>
                <span class="text-xs text-white/90 font-sans font-medium tracking-tight truncate">
                  {reel.audio}
                </span>
              </div>
            </div>

          </div>
        </div>
        );
      })}
    </div>

    <!-- Fullscreen / Theater Video Modal (Minimalist & Aesthetic Luxury Video Viewer) -->
    <div 
      id="video-theater-modal" 
      class="fixed inset-0 z-[999999] bg-black/95 backdrop-blur-2xl flex flex-col items-center justify-center p-3 sm:p-6 md:p-8 hidden opacity-0 transition-opacity duration-300 select-none"
      role="dialog"
      aria-modal="true"
      aria-label="Fullscreen Video Player"
    >
      <!-- Top Navigation Bar: Minimalist Studio Badge -->
      <div class="w-full max-w-5xl mx-auto flex items-center justify-between px-3 sm:px-6 py-2 sm:py-3 mb-2 pointer-events-auto shrink-0 z-30">
        <!-- Studio Label -->
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-white text-xs font-sans tracking-wide border border-white/15">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="theater-audio-label" class="font-medium text-white/90 truncate max-w-[240px] sm:max-w-md">Angels Beauty & Bridal Studio</span>
        </div>
      </div>

      <!-- Theater Video Container (Mathematically Centered, Vertical Pillar Frame) -->
      <div class="relative w-auto h-[78vh] sm:h-[82vh] max-h-[740px] aspect-[9/16] rounded-2xl sm:rounded-3xl overflow-hidden shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9)] border border-white/20 bg-black flex items-center justify-center pointer-events-auto group">
        
        <!-- Video Element -->
        <video 
          id="theater-video" 
          class="w-full h-full object-cover cursor-pointer" 
          loop 
          playsinline 
          autoplay
        ></video>

        <!-- Direct Floating Corner Close Button on Video Frame (Instant Touch on Mobile) -->
        <button 
          id="theater-video-corner-close" 
          type="button"
          class="absolute top-3 right-3 z-40 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-black/70 hover:bg-black/90 text-white flex items-center justify-center border border-white/30 cursor-pointer shadow-lg active:scale-90 transition-all"
          aria-label="Close Video"
          title="Close"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <!-- Play/Pause Indicator (Flashes on click with 2.5s auto-hide) -->
        <div id="theater-play-indicator" class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity duration-300 z-30">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-black/60 backdrop-blur-md flex items-center justify-center text-white shadow-2xl border border-white/20">
            <svg id="theater-play-icon" class="w-8 h-8 sm:w-10 sm:h-10 fill-current translate-x-0.5" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <svg id="theater-pause-icon" class="w-8 h-8 sm:w-10 sm:h-10 fill-current hidden" viewBox="0 0 24 24">
              <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
            </svg>
          </div>
        </div>

        <!-- Theater Bottom Controls: Sound Toggle + Tap Hint -->
        <div class="absolute bottom-0 inset-x-0 p-3.5 sm:p-4 pb-4 sm:pb-5 z-20 flex items-center justify-between bg-gradient-to-t from-black/85 via-black/40 to-transparent pointer-events-auto">
          <!-- Theater Sound Toggle Button -->
          <button 
            id="theater-sound-btn" 
            type="button" 
            class="px-3.5 py-1.5 rounded-full bg-black/60 hover:bg-black/80 backdrop-blur-md text-white text-xs font-sans flex items-center gap-2 border border-white/20 cursor-pointer transition-all active:scale-95"
            aria-label="Toggle Sound"
          >
            <!-- Speaker Active -->
            <svg id="theater-sound-active-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            </svg>
            <!-- Speaker Muted -->
            <svg id="theater-sound-muted-icon" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
            </svg>
            <span id="theater-sound-label" class="text-[11px] sm:text-xs">Sound On</span>
          </button>

          <!-- Tap Hint -->
          <span class="text-[10px] sm:text-[11px] text-white/70 font-sans tracking-tight">Tap video to pause / play</span>
        </div>
      </div>
    </div>

    <!-- Toast Notification for Share / Save Feedback -->
    <div 
      id="reel-toast" 
      class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 px-5 py-2.5 rounded-full bg-charcoal/95 backdrop-blur-md text-white text-xs font-sans font-medium shadow-xl border border-white/10 opacity-0 pointer-events-none transition-opacity duration-300"
    >
      Link copied to clipboard
    </div>

    <!-- Link out banner -->
    <div class="mt-12 text-center">
      <a 
        href={SITE_CONFIG.social.instagramUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2 text-xs font-sans font-semibold tracking-wider uppercase text-charcoal hover:text-gold-deep transition-colors border-b border-gold-deep pb-0.5"
      >
        <span>Explore daily bridal transformations & reels on @angels_beauty__parlour</span>
        <svg class="w-3.5 h-3.5 text-gold-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  // Toast Helper
  const toast = document.getElementById('reel-toast');
  function showToast(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.remove('opacity-0');
    toast.classList.add('opacity-100');
    setTimeout(() => {
      toast.classList.remove('opacity-100');
      toast.classList.add('opacity-0');
    }, 2500);
  }

  // Fullscreen Theater Modal Controls
  const theaterModal = document.getElementById('video-theater-modal');
  const theaterVideo = document.getElementById('theater-video') as HTMLVideoElement;
  const theaterAudioLabel = document.getElementById('theater-audio-label');
  const theaterCloseBtn = document.getElementById('theater-close-btn');
  const theaterPlayIndicator = document.getElementById('theater-play-indicator') as HTMLElement;
  const theaterPlayIcon = document.getElementById('theater-play-icon');
  const theaterPauseIcon = document.getElementById('theater-pause-icon');
  const theaterSoundBtn = document.getElementById('theater-sound-btn');
  const theaterSoundActiveIcon = document.getElementById('theater-sound-active-icon');
  const theaterSoundMutedIcon = document.getElementById('theater-sound-muted-icon');
  const theaterSoundLabel = document.getElementById('theater-sound-label');

  let theaterPlayTimer: any = null;

  function toggleTheaterPlayPause() {
    if (!theaterVideo) return;
    if (theaterVideo.paused) {
      theaterVideo.play();
      theaterPlayIcon?.classList.remove('hidden');
      theaterPauseIcon?.classList.add('hidden');
    } else {
      theaterVideo.pause();
      theaterPlayIcon?.classList.add('hidden');
      theaterPauseIcon?.classList.remove('hidden');
    }

    if (theaterPlayIndicator) {
      theaterPlayIndicator.classList.remove('opacity-0', 'pointer-events-none');
      theaterPlayIndicator.classList.add('opacity-100');
      if (theaterPlayTimer) clearTimeout(theaterPlayTimer);
      theaterPlayTimer = setTimeout(() => {
        theaterPlayIndicator.classList.remove('opacity-100');
        theaterPlayIndicator.classList.add('opacity-0', 'pointer-events-none');
      }, 2500);
    }
  }

  theaterVideo?.addEventListener('click', toggleTheaterPlayPause);
  theaterPlayIndicator?.addEventListener('click', toggleTheaterPlayPause);

  theaterSoundBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!theaterVideo) return;
    theaterVideo.muted = !theaterVideo.muted;
    if (!theaterVideo.muted) {
      theaterSoundActiveIcon?.classList.remove('hidden');
      theaterSoundMutedIcon?.classList.add('hidden');
      if (theaterSoundLabel) theaterSoundLabel.textContent = 'Sound On';
    } else {
      theaterSoundActiveIcon?.classList.add('hidden');
      theaterSoundMutedIcon?.classList.remove('hidden');
      if (theaterSoundLabel) theaterSoundLabel.textContent = 'Muted';
    }
  });

  const headerContainer = document.getElementById('header-container');
  const floatingActions = document.getElementById('floating-actions');

  function openTheaterModal(videoSrc: string, audioTitle: string, startTime = 0) {
    if (!theaterModal || !theaterVideo) return;

    // Teleport to body to escape any parent section stacking context
    if (theaterModal.parentElement !== document.body) {
      document.body.appendChild(theaterModal);
    }

    // Hide navbar and floating action buttons while in fullscreen mode
    if (headerContainer) headerContainer.style.setProperty('display', 'none', 'important');
    if (floatingActions) floatingActions.style.setProperty('display', 'none', 'important');

    theaterVideo.src = videoSrc;
    if (startTime > 0) {
      try {
        theaterVideo.currentTime = startTime;
      } catch (err) {}
    }
    if (theaterAudioLabel) theaterAudioLabel.textContent = audioTitle || 'Angels Beauty & Bridal Studio';
    
    theaterModal.classList.remove('hidden');
    requestAnimationFrame(() => {
      theaterModal.classList.remove('opacity-0');
      theaterModal.classList.add('opacity-100');
    });

    theaterVideo.muted = false;
    theaterVideo.play().catch(() => {});
    theaterSoundActiveIcon?.classList.remove('hidden');
    theaterSoundMutedIcon?.classList.add('hidden');
    if (theaterSoundLabel) theaterSoundLabel.textContent = 'Sound On';
    document.body.classList.add('overflow-hidden');
  }

  function closeTheaterModal() {
    if (!theaterModal || !theaterVideo) return;
    theaterVideo.pause();
    theaterVideo.src = '';
    theaterModal.classList.add('opacity-0');
    theaterModal.classList.remove('opacity-100');
    if (theaterPlayTimer) clearTimeout(theaterPlayTimer);
    theaterPlayIndicator?.classList.add('opacity-0', 'pointer-events-none');
    theaterPlayIndicator?.classList.remove('opacity-100');
    setTimeout(() => {
      theaterModal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      // Restore navbar and floating actions
      if (headerContainer) headerContainer.style.removeProperty('display');
      if (floatingActions) floatingActions.style.removeProperty('display');
    }, 300);
  }

  theaterCloseBtn?.addEventListener('click', closeTheaterModal);
  const cornerCloseBtn = document.getElementById('theater-video-corner-close');
  cornerCloseBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeTheaterModal();
  });
  theaterModal?.addEventListener('click', (e) => {
    if (e.target === theaterModal) closeTheaterModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && theaterModal && !theaterModal.classList.contains('hidden')) {
      closeTheaterModal();
    }
  });

  // Handle Each Reel Separately
  const reelContainers = document.querySelectorAll('.reel-container');

  reelContainers.forEach(container => {
    const video = container.querySelector('.reel-video') as HTMLVideoElement;
    const soundBtn = container.querySelector('.reel-sound-btn');
    const soundMutedIcon = container.querySelector('.sound-muted-icon');
    const soundActiveIcon = container.querySelector('.sound-active-icon');
    const expandBtn = container.querySelector('.reel-expand-btn') as HTMLElement;
    const playIndicator = container.querySelector('.reel-play-indicator') as HTMLElement;
    const playIcon = container.querySelector('.play-icon');
    const pauseIcon = container.querySelector('.pause-icon');
    const likeBtn = container.querySelector('.reel-like-btn');
    const likeIcon = container.querySelector('.like-icon');
    const likeCount = container.querySelector('.like-count');
    const shareBtn = container.querySelector('.reel-share-btn');
    const saveBtn = container.querySelector('.reel-save-btn');
    const saveIcon = container.querySelector('.save-icon');
    const saveText = container.querySelector('.save-text');

    if (!video) return;

    // 1. Play / Pause by tapping video with 2.5–3 Second Auto-Hide
    let playTimer: any = null;

    function handlePlayPauseToggle(e?: Event) {
      if (e) e.stopPropagation();

      if (video.paused) {
        video.play();
        playIcon?.classList.remove('hidden');
        pauseIcon?.classList.add('hidden');
      } else {
        video.pause();
        playIcon?.classList.add('hidden');
        pauseIcon?.classList.remove('hidden');
      }

      // Show the button indicator
      if (playIndicator) {
        playIndicator.classList.remove('opacity-0', 'pointer-events-none');
        playIndicator.classList.add('opacity-100');

        // Automatically hide after 2.5 seconds (User requested max 3 seconds auto-hide)
        if (playTimer) clearTimeout(playTimer);
        playTimer = setTimeout(() => {
          playIndicator.classList.remove('opacity-100');
          playIndicator.classList.add('opacity-0', 'pointer-events-none');
        }, 2500);
      }
    }

    video.addEventListener('click', handlePlayPauseToggle);
    playIndicator?.addEventListener('click', handlePlayPauseToggle);

    // 2. Expand / Fullscreen Button for Desktop Theater Mode
    expandBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const currentPos = video.currentTime || 0;
      video.pause();
      const videoSrc = expandBtn.getAttribute('data-video-src') || '';
      const audioTitle = expandBtn.getAttribute('data-audio') || '';
      openTheaterModal(videoSrc, audioTitle, currentPos);
    });

    // 3. Sound Mute / Unmute Toggle
    soundBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      video.muted = !video.muted;
      if (!video.muted) {
        video.volume = 1.0;
        soundMutedIcon?.classList.add('hidden');
        soundActiveIcon?.classList.remove('hidden');
        showToast('Sound unmuted 🔊');
      } else {
        soundMutedIcon?.classList.remove('hidden');
        soundActiveIcon?.classList.add('hidden');
        showToast('Sound muted 🔇');
      }
    });

    // 4. Like Button Toggle
    let isLiked = false;
    likeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      isLiked = !isLiked;
      if (isLiked) {
        likeIcon?.classList.add('fill-red-500', 'text-red-500');
        likeIcon?.classList.remove('fill-none', 'stroke-current');
        if (likeCount) {
          likeCount.classList.add('text-red-400');
        }
      } else {
        likeIcon?.classList.remove('fill-red-500', 'text-red-500');
        likeIcon?.classList.add('fill-none', 'stroke-current');
        if (likeCount) {
          likeCount.classList.remove('text-red-400');
        }
      }
    });

    // 5. Share Button (Paper Plane)
    shareBtn?.addEventListener('click', async (e) => {
      e.stopPropagation();
      const currentUrl = window.location.href;
      if (navigator.share) {
        try {
          await navigator.share({
            title: 'Angels Beauty Parlour & Bridal Studio',
            text: 'Check out this bridal reel from Angels Beauty Studio!',
            url: currentUrl
          });
        } catch {
          navigator.clipboard?.writeText(currentUrl);
          showToast('Link copied to clipboard ✨');
        }
      } else {
        navigator.clipboard?.writeText(currentUrl);
        showToast('Link copied to clipboard ✨');
      }
    });

    // 6. Save Button Toggle
    let isSaved = false;
    saveBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      isSaved = !isSaved;
      if (isSaved) {
        saveIcon?.classList.add('fill-[#C9A66B]', 'text-[#C9A66B]');
        saveIcon?.classList.remove('fill-none', 'stroke-current');
        if (saveText) {
          saveText.textContent = 'Saved';
          saveText.classList.add('text-gold');
        }
        showToast('Saved to your collection 🔖');
      } else {
        saveIcon?.classList.remove('fill-[#C9A66B]', 'text-[#C9A66B]');
        saveIcon?.classList.add('fill-none', 'stroke-current');
        if (saveText) {
          saveText.textContent = 'Save';
          saveText.classList.remove('text-gold');
        }
      }
    });
  });

  // 7. Smooth autoplay on mobile scroll when a reel is active in view
  if ('IntersectionObserver' in window) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target.querySelector('.reel-video') as HTMLVideoElement;
        if (video) {
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      });
    }, { threshold: 0.5 });

    reelContainers.forEach(container => videoObserver.observe(container));
  }
</script>
