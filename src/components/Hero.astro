---
import { SITE_CONFIG } from '../config/site';
---

<section class="relative min-h-[100dvh] sm:min-h-[760px] lg:min-h-[820px] w-full flex flex-col justify-between overflow-hidden bg-canvas pt-20 pb-4 sm:py-28">
  <!-- Generated Luxury Background Image with Subtle Editorial Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero-bg.webp" 
      alt="Angels Beauty Parlour & Bridal Studio Interior" 
      class="w-full h-full object-cover object-[70%_center] sm:object-center transform scale-100 transition-transform duration-1000"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width="1920"
      height="1080"
    />
    <!-- Subtle Gradient Overlay: Clean ivory fade on left for text readability, keeping the luxury illuminated vanity and salon interior visible on right -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#FDFBF7]/96 via-[#FDFBF7]/85 to-[#FDFBF7]/20 sm:to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#FDFBF7]/90 via-transparent to-[#FDFBF7]/20 sm:to-transparent"></div>
  </div>

  <!-- Hero Content (Full Responsive Desktop & Mobile Full-Fit Screen) -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex-1 flex flex-col justify-between pt-4 sm:pt-16 pb-2 sm:pb-6 text-left">
    
    <!-- Main Center Hero Text & CTAs (Strictly Left-Aligned & Editorial Structure) -->
    <div class="max-w-2xl sm:max-w-3xl space-y-4 sm:space-y-6 pt-14 xs:pt-18 sm:pt-0 my-auto text-left hero-text-reveal">
      
      <!-- Location & Status Badge -->
      <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-3.5 py-1.5 rounded-full border border-black/[0.08] bg-white/90 backdrop-blur-md text-charcoal shadow-2xs max-w-full">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
        <span class="text-[10px] xs:text-[11px] sm:text-xs font-sans font-medium text-charcoal/90 tracking-tight whitespace-nowrap truncate">
          Mananthavady, Wayanad · Open Daily 9 AM – 8 PM
        </span>
      </div>

      <!-- Headline with Structured Left-Aligned Typography -->
      <h1 class="text-3xl xs:text-4xl sm:text-5xl lg:text-[4rem] font-light text-charcoal leading-[1.12] sm:leading-[1.08] tracking-[-0.035em] text-left">
        Where Timeless <br class="block" />
        Bridal Grace <br class="block" />
        <span class="italic font-normal text-gold-deep font-serif">Meets Modern Artistry.</span>
      </h1>

      <!-- One Line Support Text -->
      <p class="text-xs sm:text-base lg:text-lg text-muted max-w-md sm:max-w-xl font-sans leading-relaxed tracking-tight text-left">
        Wayanad's signature studio for bespoke HD bridal makeup, Korean glass skin facials, advanced hair transformations, and tranquil salon pampering.
      </p>

      <!-- CTA Action Buttons: Symmetrically Left-Aligned -->
      <div class="flex flex-row items-center gap-2 sm:gap-3.5 pt-1.5 sm:pt-3 text-left">
        <a 
          href="/booking" 
          class="inline-flex items-center justify-center py-2.5 sm:py-3 px-4 xs:px-5 sm:px-7 rounded-full text-[10.5px] xs:text-[11px] sm:text-xs font-semibold tracking-wide uppercase bg-gold hover:bg-gold-hover text-charcoal shadow-xs transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 active:scale-97 text-center shrink-0"
        >
          Book Appointment
        </a>
        <a 
          href="/bridal" 
          class="inline-flex items-center justify-center py-2.5 sm:py-3 px-4 xs:px-5 sm:px-7 rounded-full text-[10.5px] xs:text-[11px] sm:text-xs font-semibold tracking-wide uppercase border border-gold-border-strong text-charcoal bg-white/85 backdrop-blur-md hover:bg-white shadow-2xs transition-all duration-200 active:scale-97 text-center shrink-0"
        >
          Bridal Packages
        </a>
      </div>

    </div>

    <!-- Quick Assurance Badges & Mobile Scroll Cue (Structured Architectural Left Grid) -->
    <div class="mt-auto pt-4 sm:pt-7 border-t border-black/[0.06] w-full max-w-2xl text-left">
      <div class="grid grid-cols-3 gap-1.5 sm:gap-4 text-xs font-sans text-muted">
        <div class="border-l border-gold/40 pl-2 sm:pl-3 space-y-0.5">
          <span class="block text-charcoal font-semibold text-[11px] xs:text-xs sm:text-sm tracking-tight truncate">Bridal Suite</span>
          <span class="text-[9.5px] xs:text-[10px] sm:text-[11px] text-muted tracking-tight truncate block">Private lounge</span>
        </div>
        <div class="border-l border-gold/40 pl-2 sm:pl-3 space-y-0.5">
          <span class="block text-charcoal font-semibold text-[11px] xs:text-xs sm:text-sm tracking-tight truncate">Glass Skin</span>
          <span class="text-[9.5px] xs:text-[10px] sm:text-[11px] text-muted tracking-tight truncate block">Aesthetic care</span>
        </div>
        <div class="border-l border-gold/40 pl-2 sm:pl-3 space-y-0.5">
          <span class="block text-charcoal font-semibold text-[11px] xs:text-xs sm:text-sm tracking-tight truncate">Open 7 Days</span>
          <span class="text-[9.5px] xs:text-[10px] sm:text-[11px] text-muted tracking-tight truncate block">9 AM to 8 PM</span>
        </div>
      </div>

      <!-- Subtle Mobile & Desktop Scroll Indicator -->
      <a 
        href="/#services" 
        class="flex items-center justify-start gap-1.5 pt-3 pb-1 text-muted/60 hover:text-gold-deep transition-colors text-[10px] font-sans uppercase tracking-[0.2em]"
        aria-label="Scroll down to explore services"
      >
        <span>Explore Studio</span>
        <svg class="w-3 h-3 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
