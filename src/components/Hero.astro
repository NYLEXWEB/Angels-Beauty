---
---

<section class="relative min-h-[100dvh] sm:min-h-[760px] lg:min-h-[820px] w-full flex flex-col justify-between overflow-hidden bg-canvas pt-20 pb-4 sm:py-28">
  <!-- Generated Luxury Background Image with Subtle Editorial Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero-bg.webp" 
      alt="Luxury Interior of Angels Beauty Parlour and Bridal Studio Mananthavady Wayanad" 
      class="w-full h-full object-cover object-[70%_center] sm:object-center transform scale-100 transition-transform duration-1000"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width="1920"
      height="1080"
    />
    <!-- Subtle Gradient Overlay: Clean ivory fade on left for text readability, keeping the luxury illuminated vanity and salon interior visible on right -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#FDFBF7]/96 via-[#FDFBF7]/85 to-[#FDFBF7]/20 sm:to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#FDFBF7]/90 via-transparent to-[#FDFBF7]/20 sm:to-transparent"></div>
  </div>

  <!-- Hero Content (Full Responsive Desktop & Mobile Full-Fit Screen) -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex-1 flex flex-col justify-between pt-4 sm:pt-16 pb-2 sm:pb-6 text-left">
    
    <!-- Main Center Hero Text & CTAs (Strictly Left-Aligned & Editorial Structure) -->
    <div class="max-w-2xl sm:max-w-3xl space-y-4 sm:space-y-6 pt-14 xs:pt-18 sm:pt-0 my-auto text-left hero-text-reveal">
    
      <!-- Headline with Structured Left-Aligned Typography -->
      <h1 class="text-3xl xs:text-4xl sm:text-5xl lg:text-[4rem] font-light text-charcoal leading-[1.12] sm:leading-[1.08] tracking-[-0.035em] text-left">
        Where Timeless <br class="block" />
        Bridal Grace <br class="block" />
        <span class="italic font-normal text-gold-deep font-serif">Meets Modern Artistry.</span>
        <span class="sr-only"> - Best Bridal Makeup Studio & Beauty Parlour in Mananthavady, Wayanad</span>
      </h1>

      <!-- One Line Support Text -->
      <p class="text-xs sm:text-base lg:text-lg text-muted max-w-md sm:max-w-xl font-sans leading-relaxed tracking-tight text-left">
        Wayanad's signature studio for bespoke HD bridal makeup, Korean glass skin facials, advanced hair transformations, and tranquil salon pampering.
      </p>

      <!-- CTA Action Buttons: Symmetrically Left-Aligned -->
      <div class="flex flex-row items-center gap-2 sm:gap-3.5 pt-1.5 sm:pt-3 text-left">
        <a 
          href="/booking" 
          class="btn-luxury-shimmer inline-flex items-center justify-center py-2.5 sm:py-3 px-4 xs:px-5 sm:px-7 rounded-full text-[10.5px] xs:text-[11px] sm:text-xs font-semibold tracking-wide uppercase bg-gold hover:bg-gold-hover text-charcoal shadow-xs transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 active:scale-97 text-center shrink-0"
        >
          Book Appointment
        </a>
        <a 
          href="/bridal" 
          class="btn-luxury-shimmer inline-flex items-center justify-center py-2.5 sm:py-3 px-4 xs:px-5 sm:px-7 rounded-full text-[10.5px] xs:text-[11px] sm:text-xs font-semibold tracking-wide uppercase border border-gold-border-strong text-charcoal bg-white/85 backdrop-blur-md hover:bg-white shadow-2xs transition-all duration-200 active:scale-97 text-center shrink-0"
        >
          Bridal Packages
        </a>
      </div>

    </div>

    <!-- Editorial Trust Strip (Clean 3-Item Metric Layout, Non-Intrusive) -->
    <div class="pt-4 sm:pt-8 pb-2 border-t border-black/[0.08] flex items-center justify-between gap-4 text-charcoal">
      <div class="flex items-center gap-3">
        <span class="font-serif text-xl sm:text-3xl font-medium text-charcoal">1,400+</span>
        <span class="text-[9.5px] sm:text-xs text-muted font-sans uppercase tracking-wider block leading-tight">Brides<br/>Styled</span>
      </div>
      <div class="h-6 w-px bg-black/[0.1] hidden xs:block"></div>
      <div class="flex items-center gap-3">
        <span class="font-serif text-xl sm:text-3xl font-medium text-charcoal">4.9★</span>
        <span class="text-[9.5px] sm:text-xs text-muted font-sans uppercase tracking-wider block leading-tight">Google<br/>Rating</span>
      </div>
      <div class="h-6 w-px bg-black/[0.1] hidden xs:block"></div>
      <div class="flex items-center gap-3">
        <span class="font-serif text-xl sm:text-3xl font-medium text-charcoal">10+</span>
        <span class="text-[9.5px] sm:text-xs text-muted font-sans uppercase tracking-wider block leading-tight">Years in<br/>Wayanad</span>
      </div>
    </div>

  </div>
</section>
