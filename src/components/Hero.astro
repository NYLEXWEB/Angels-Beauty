---
import { SITE_CONFIG } from '../config/site';
---

<section class="relative min-h-[95dvh] sm:min-h-[720px] w-full flex items-center overflow-hidden bg-canvas py-20 sm:py-28">
  <!-- Generated Luxury Background Image with Subtle Editorial Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero-bg.jpg" 
      alt="Angels Beauty Parlour & Bridal Studio Interior" 
      class="w-full h-full object-cover object-[70%_center] sm:object-center transform scale-100 transition-transform duration-1000"
      loading="eager"
    />
    <!-- Subtle Gradient Overlay: Clean ivory fade on left for text readability, keeping the luxury illuminated vanity and salon interior visible on right -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#FDFBF7]/96 via-[#FDFBF7]/85 to-[#FDFBF7]/20 sm:to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#FDFBF7]/90 via-transparent to-[#FDFBF7]/20 sm:to-transparent"></div>
  </div>

  <!-- Hero Content (Full Responsive Desktop Width) -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-24 pb-6">
    <div class="max-w-2xl sm:max-w-3xl space-y-6 sm:space-y-7 pt-2 sm:pt-0 hero-text-reveal">
      
      <!-- Location & Status Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-black/[0.08] bg-white/90 backdrop-blur-md text-charcoal shadow-2xs max-w-fit">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
        <span class="text-[11px] sm:text-xs font-sans font-medium text-charcoal/90 tracking-tight">
          Mananthavady, Wayanad · Open Daily 9 AM – 8 PM
        </span>
      </div>

      <!-- Headline with 100% Apple SF Pro Font Style (Slim / Light Weight) -->
      <h1 class="text-3xl xs:text-4xl sm:text-5xl lg:text-[4rem] font-light text-charcoal leading-[1.08] tracking-[-0.035em]">
        Where Timeless Bridal Grace Meets Modern Artistry.
      </h1>

      <!-- One Line Support Text -->
      <p class="text-sm sm:text-base lg:text-lg text-muted max-w-xl font-sans leading-relaxed tracking-tight">
        Wayanad's signature studio for bespoke HD bridal makeup, Korean glass skin facials, advanced hair transformations, and tranquil salon pampering.
      </p>

      <!-- CTA Action Buttons (Apple Style Pills) -->
      <div class="flex flex-row items-center gap-2.5 sm:gap-3.5 pt-2 sm:pt-3">
        <a 
          href="/booking" 
          class="inline-flex items-center justify-center py-3 px-5 sm:px-7 rounded-full text-[11px] sm:text-xs font-semibold tracking-wide uppercase bg-gold hover:bg-gold-hover text-charcoal shadow-xs transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 active:scale-97 text-center shrink-0"
        >
          Book Appointment
        </a>
        <a 
          href="/bridal" 
          class="inline-flex items-center justify-center py-3 px-5 sm:px-7 rounded-full text-[11px] sm:text-xs font-semibold tracking-wide uppercase border border-gold-border-strong text-charcoal bg-white/85 backdrop-blur-md hover:bg-white shadow-2xs transition-all duration-200 active:scale-97 text-center shrink-0"
        >
          Bridal Packages
        </a>
      </div>

      <!-- Quick Assurance Badges (Responsive 3-Column Grid) -->
      <div class="pt-6 sm:pt-7 border-t border-black/[0.06] grid grid-cols-3 gap-4 text-xs font-sans text-muted max-w-lg">
        <div class="space-y-0.5">
          <span class="block text-charcoal font-semibold text-xs sm:text-sm tracking-tight">Bridal Suite</span>
          <span class="text-[11px] text-muted tracking-tight">Private lounge</span>
        </div>
        <div class="space-y-0.5">
          <span class="block text-charcoal font-semibold text-xs sm:text-sm tracking-tight">Glass Skin</span>
          <span class="text-[11px] text-muted tracking-tight">Aesthetic care</span>
        </div>
        <div class="space-y-0.5">
          <span class="block text-charcoal font-semibold text-xs sm:text-sm tracking-tight">Open 7 Days</span>
          <span class="text-[11px] text-muted tracking-tight">9 AM to 8 PM</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Scroll Cue -->
  <a 
    href="/#services" 
    class="hidden md:flex absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex-col items-center gap-1.5 text-muted/70 hover:text-gold-deep transition-colors text-[10px] font-sans uppercase tracking-[0.2em]"
    aria-label="Scroll down to explore services"
  >
    <span>Explore Studio</span>
    <svg class="w-3.5 h-3.5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </a>
</section>
