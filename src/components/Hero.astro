---
import { SITE_CONFIG } from '../config/site';
---

<section class="relative h-[100dvh] min-h-[560px] sm:min-h-[640px] max-h-[1080px] w-full flex items-center overflow-hidden bg-canvas">
  <!-- Generated Luxury Background Image with Subtle Editorial Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero-bg.jpg" 
      alt="Angels Beauty Parlour & Bridal Studio Interior" 
      class="w-full h-full object-cover object-[70%_center] sm:object-center transform scale-100 transition-transform duration-1000"
      loading="eager"
    />
    <!-- Subtle Gradient Overlay: Clean ivory fade on left for text readability, keeping the luxury illuminated vanity and salon interior visible on right -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#FDFBF7]/95 via-[#FDFBF7]/80 to-[#FDFBF7]/25 sm:to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#FDFBF7]/90 via-transparent to-[#FDFBF7]/20 sm:to-transparent"></div>
  </div>

  <!-- Hero Content (Single Screen Fit - No Scroll Required on Initial Load) -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 sm:pt-20 pb-4 sm:pb-8">
    <div class="max-w-2xl sm:max-w-3xl space-y-3 sm:space-y-6 hero-text-reveal">
      
      <!-- Location & Status Badge -->
      <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 py-1 sm:py-1.5 rounded-full border border-gold-border/80 bg-canvas/85 backdrop-blur-md text-charcoal shadow-xs max-w-fit">
        <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
        <span class="text-[9.5px] xs:text-[10.5px] sm:text-xs font-sans font-medium uppercase tracking-wider sm:tracking-[0.16em] text-charcoal/90 whitespace-nowrap">
          Mananthavady, Wayanad · Open Daily 9 AM – 8 PM
        </span>
      </div>

      <!-- Headline -->
      <h1 class="text-[1.85rem] xs:text-[2.15rem] sm:text-5xl md:text-6xl lg:text-[4rem] font-serif font-normal text-charcoal leading-[1.12] sm:leading-[1.08] tracking-tight">
        Where Timeless <span class="italic font-normal font-serif text-gold-deep">Bridal Grace</span> Meets Modern Artistry.
      </h1>

      <!-- One Line Support Text -->
      <p class="text-[12.5px] xs:text-[13.5px] sm:text-base md:text-lg text-muted/95 max-w-xl font-sans leading-relaxed">
        Wayanad's signature studio for bespoke HD bridal makeup, Korean glass skin facials, advanced hair transformations, and tranquil salon pampering.
      </p>

      <!-- CTA Action Buttons (Side-by-side on mobile for compact, elegant single-screen fit) -->
      <div class="grid grid-cols-2 gap-2.5 sm:flex sm:flex-row sm:items-center sm:gap-4 pt-1 sm:pt-2 max-w-sm sm:max-w-none">
        <a 
          href="/#booking" 
          class="inline-flex items-center justify-center py-2.5 sm:py-3.5 px-3 sm:px-7 rounded-xl sm:rounded-full text-[11px] xs:text-xs sm:text-sm font-semibold tracking-wider uppercase bg-gold hover:bg-gold-hover text-charcoal shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 active:scale-98 text-center"
        >
          Book Appointment
        </a>
        <a 
          href="/bridal" 
          class="inline-flex items-center justify-center py-2.5 sm:py-3.5 px-3 sm:px-7 rounded-xl sm:rounded-full text-[11px] xs:text-xs sm:text-sm font-semibold tracking-wider uppercase border border-gold-strong text-charcoal bg-canvas/80 backdrop-blur-xs hover:bg-surface transition-all duration-300 active:scale-98 text-center"
        >
          Bridal Packages
        </a>
      </div>

      <!-- Quick Assurance Badges (Compact 3-Column Single-Row Grid) -->
      <div class="pt-3 sm:pt-5 border-t border-gold-border/40 grid grid-cols-3 gap-2 sm:gap-4 text-xs font-sans text-muted max-w-xl">
        <div class="space-y-0.5">
          <span class="block text-charcoal font-medium text-[11px] sm:text-xs">Bridal Suite</span>
          <span class="text-[9.5px] sm:text-[11px] text-subtle">Private lounge</span>
        </div>
        <div class="space-y-0.5">
          <span class="block text-charcoal font-medium text-[11px] sm:text-xs">Glass Skin</span>
          <span class="text-[9.5px] sm:text-[11px] text-subtle">Aesthetic care</span>
        </div>
        <div class="space-y-0.5">
          <span class="block text-charcoal font-medium text-[11px] sm:text-xs">Open 7 Days</span>
          <span class="text-[9.5px] sm:text-[11px] text-subtle">9 AM to 8 PM</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Scroll Cue (Discreet and elegant) -->
  <a 
    href="/#services" 
    class="hidden md:flex absolute bottom-5 left-1/2 -translate-x-1/2 z-10 flex-col items-center gap-1.5 text-muted/70 hover:text-gold-deep transition-colors text-[10px] font-sans uppercase tracking-[0.2em]"
    aria-label="Scroll down to explore services"
  >
    <span>Explore Studio</span>
    <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 9l-7 7-7-7"/>
    </svg>
  </a>
</section>
