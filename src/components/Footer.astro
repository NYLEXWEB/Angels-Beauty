---
import { SITE_CONFIG } from '../config/site';
---

<footer class="bg-surface border-t border-gold-border/40 text-charcoal pt-16 pb-20 sm:pb-16 px-6 sm:px-8 lg:px-12 overflow-x-clip">
  <div class="max-w-7xl mx-auto">
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-8 pb-10 border-b border-gold-border/30">
      
      <!-- Brand & Mission Column (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full overflow-hidden p-0.5 border border-gold/40 shadow-sm bg-canvas shrink-0">
            <img 
              src="/images/brand/logo.webp" 
              alt="Angels Beauty Parlour and Bridal Studio" 
              class="w-full h-full object-cover rounded-full"
              width="48"
              height="48"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <span class="font-serif text-xl sm:text-2xl font-semibold tracking-tight text-charcoal block leading-none">
              Angels
            </span>
            <span class="font-sans text-[10px] sm:text-[11px] font-medium tracking-[0.18em] uppercase text-gold-deep block mt-1">
              Beauty Parlour & Bridal Studio
            </span>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-md font-sans">
          Wayanad's signature address for bespoke bridal artistry, advanced hair rejuvenation, and Korean glass skin therapies at PP Building, Mananthavady.
        </p>

        <!-- Social Links (40x40 touch targets) -->
        <div class="flex items-center gap-3 pt-1">
          <!-- Instagram -->
          <a 
            href={SITE_CONFIG.social.instagramUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-gold-border flex items-center justify-center text-charcoal hover:bg-canvas hover:text-gold-deep hover:border-gold transition-all"
            aria-label="Instagram profile"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <!-- WhatsApp -->
          <a 
            href={SITE_CONFIG.contact.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-gold-border flex items-center justify-center text-charcoal hover:bg-canvas hover:text-[#25D366] hover:border-[#25D366] transition-all"
            aria-label="WhatsApp chat"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>
          <!-- Call -->
          <a 
            href={`tel:${SITE_CONFIG.contact.phoneTel}`} 
            class="w-10 h-10 rounded-full border border-gold-border flex items-center justify-center text-charcoal hover:bg-canvas hover:text-gold-deep hover:border-gold transition-all"
            aria-label="Call salon phone"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Navigation (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-sans font-semibold tracking-[0.2em] uppercase text-charcoal">
          Studio Navigation
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm text-muted font-sans">
          <li>
            <a href="/services" class="hover:text-gold-deep transition-colors py-0.5 block">Services & Treatments</a>
          </li>
          <li>
            <a href="/bridal" class="hover:text-gold-deep transition-colors text-gold-deep font-medium py-0.5 block">Bridal Packages Portfolio</a>
          </li>
          <li>
            <a href="/about" class="hover:text-gold-deep transition-colors py-0.5 block">About Studio Sanctuary</a>
          </li>
          <li>
            <a href="/gallery" class="hover:text-gold-deep transition-colors py-0.5 block">Salon Space Gallery</a>
          </li>
          <li>
            <a href="/reviews" class="hover:text-gold-deep transition-colors py-0.5 block">Client Testimonials</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-gold-deep transition-colors py-0.5 block">Studio Location & Hours</a>
          </li>
          <li>
            <a href="/booking" class="hover:text-gold-deep transition-colors py-0.5 block">Book Appointment</a>
          </li>
        </ul>
      </div>

      <!-- Hours & Location (4 cols) -->
      <div class="lg:col-span-4 space-y-3">
        <h3 class="text-xs font-sans font-semibold tracking-[0.2em] uppercase text-charcoal">
          Hours & Location
        </h3>
        <div class="space-y-2.5 text-xs sm:text-sm text-muted font-sans">
          <div>
            <p class="font-medium text-charcoal">{SITE_CONFIG.hours.days}</p>
            <p class="text-xs text-gold-deep font-semibold">{SITE_CONFIG.hours.timings}</p>
            <p class="text-[11px] text-muted/80">{SITE_CONFIG.hours.note}</p>
          </div>

          <div class="pt-1">
            <p class="font-medium text-charcoal">Mananthavady Studio</p>
            <p class="text-xs leading-relaxed">{SITE_CONFIG.address.full}</p>
            <a 
              href={SITE_CONFIG.maps.directionsUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs text-gold-deep font-medium hover:underline mt-1"
            >
              Get Directions →
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Credit -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] sm:text-xs text-muted/80 font-sans text-center sm:text-left">
      <p>© {new Date().getFullYear()} {SITE_CONFIG.name}.</p>
      <div class="flex items-center gap-3">
        <span>Mananthavady, Wayanad</span>
        <span class="w-1 h-1 rounded-full bg-gold/50"></span>
        <span class="text-charcoal font-medium tracking-wide">Designed by NYLEX</span>
      </div>
    </div>
  </div>
</footer>
