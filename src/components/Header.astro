---
import { SITE_CONFIG } from '../config/site';

const currentPath = Astro.url.pathname;
const isBridalActive = currentPath === '/bridal' || currentPath === '/bridal/';
---

<!-- Header Wrapper Container: Merged when unscrolled; edge-to-edge on mobile, floating on desktop when scrolled -->
<div id="header-container" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 pointer-events-none px-0 pt-0">
  <header 
    id="site-header" 
    class="w-full transition-all duration-300 py-3.5 sm:py-5 px-4 sm:px-8 lg:px-12 bg-transparent border-b border-transparent pointer-events-auto"
  >
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <!-- Brand Identity -->
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0" aria-label="Angels Beauty Parlour Homepage">
        <div class="relative w-9 h-9 sm:w-11 sm:h-11 rounded-full overflow-hidden p-0.5 border border-gold/50 shadow-xs transition-transform duration-300 group-hover:scale-105 shrink-0 bg-white/80 backdrop-blur-xs">
          <img 
            src="/images/logo.png" 
            alt="Angels Beauty Parlour Emblem" 
            class="w-full h-full object-cover rounded-full" 
            width="44" 
            height="44"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-lg sm:text-2xl font-semibold tracking-tight text-charcoal leading-none group-hover:text-gold-deep transition-colors">
            Angels
          </span>
          <span class="font-sans text-[8.5px] sm:text-[10px] font-medium tracking-[0.2em] uppercase text-muted mt-0.5 sm:mt-1 leading-none">
            Beauty & Bridal Studio
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-7 text-[13px] font-medium text-charcoal/90 tracking-wide uppercase font-sans">
        <a href="/#services" class="hover:text-gold-deep transition-colors py-1 relative group">
          Services
          <span class="absolute bottom-0 left-0 w-0 h-[1.5px] bg-gold transition-all duration-300 group-hover:w-full"></span>
        </a>
        
        <!-- Bridal Packages: Fixed bug where it was auto-selected on home page -->
        <a 
          href="/bridal" 
          class={`hover:text-gold-deep transition-colors py-1 relative group ${
            isBridalActive ? 'text-gold-deep font-semibold' : ''
          }`}
        >
          Bridal Packages
          <span class={`absolute bottom-0 left-0 h-[1.5px] bg-gold transition-all duration-300 ${
            isBridalActive ? 'w-full' : 'w-0 group-hover:w-full'
          }`}></span>
        </a>

        <a href="/#about" class="hover:text-gold-deep transition-colors py-1 relative group">
          About Studio
          <span class="absolute bottom-0 left-0 w-0 h-[1.5px] bg-gold transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="/#gallery" class="hover:text-gold-deep transition-colors py-1 relative group">
          Gallery
          <span class="absolute bottom-0 left-0 w-0 h-[1.5px] bg-gold transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="/#reviews" class="hover:text-gold-deep transition-colors py-1 relative group">
          Reviews
          <span class="absolute bottom-0 left-0 w-0 h-[1.5px] bg-gold transition-all duration-300 group-hover:w-full"></span>
        </a>
        <a href="/#contact" class="hover:text-gold-deep transition-colors py-1 relative group">
          Location & Hours
          <span class="absolute bottom-0 left-0 w-0 h-[1.5px] bg-gold transition-all duration-300 group-hover:w-full"></span>
        </a>
      </nav>

      <!-- Header Actions -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Direct Call Button -->
        <a 
          href={`tel:${SITE_CONFIG.contact.phoneTel}`} 
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl border border-gold-border/70 text-charcoal bg-white/70 hover:bg-gold/15 backdrop-blur-xs flex items-center justify-center transition-colors shadow-xs"
          aria-label="Call salon phone directly"
        >
          <svg class="w-4 h-4 text-gold-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </a>

        <a 
          href="/#booking" 
          class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-xs font-semibold tracking-wider uppercase bg-gold hover:bg-gold-hover text-charcoal shadow-sm transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 active:scale-98"
        >
          Book Now
        </a>

        <!-- Mobile Hamburger Button -->
        <button 
          type="button" 
          id="mobile-menu-trigger" 
          class="lg:hidden w-9 h-9 sm:w-10 sm:h-10 rounded-xl border border-gold-border/70 flex items-center justify-center text-charcoal bg-white/70 backdrop-blur-xs hover:bg-surface transition-colors shadow-xs"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-4 h-4 sm:w-5 sm:h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Fullscreen Drawer -->
  <div 
    id="mobile-menu-drawer" 
    class="pointer-events-auto fixed inset-x-3 sm:inset-x-6 top-16 sm:top-20 h-[calc(100dvh-80px)] rounded-2xl bg-canvas/98 backdrop-blur-2xl border border-gold-border/70 p-5 sm:p-6 flex flex-col justify-between overflow-y-auto hidden lg:hidden transition-all duration-300 shadow-2xl z-50"
  >
    <div class="flex flex-col gap-2.5 pt-1">
      <span class="text-[10px] font-sans font-semibold tracking-[0.25em] uppercase text-muted border-b border-gold-border/30 pb-2">
        Menu Navigation
      </span>
      <a href="/#services" class="mobile-nav-link py-2 text-xl font-serif text-charcoal hover:text-gold-deep transition-colors flex items-center justify-between border-b border-gold-border/15">
        <span>Services & Treatments</span>
        <span class="text-xs text-gold-deep font-sans">38 Menu →</span>
      </a>
      <a href="/bridal" class={`mobile-nav-link py-2 text-xl font-serif transition-colors flex items-center justify-between border-b border-gold-border/15 ${
        isBridalActive ? 'text-gold-deep font-semibold' : 'text-charcoal'
      }`}>
        <span>Bridal Packages</span>
        <span class="text-[10px] uppercase font-sans tracking-widest px-2.5 py-0.5 rounded-full bg-gold/20 text-gold-deep">Featured</span>
      </a>
      <a href="/#about" class="mobile-nav-link py-2 text-xl font-serif text-charcoal hover:text-gold-deep transition-colors flex items-center justify-between border-b border-gold-border/15">
        <span>About Our Studio</span>
        <span class="text-xs text-muted/60 font-sans">→</span>
      </a>
      <a href="/#gallery" class="mobile-nav-link py-2 text-xl font-serif text-charcoal hover:text-gold-deep transition-colors flex items-center justify-between border-b border-gold-border/15">
        <span>Salon Gallery</span>
        <span class="text-xs text-muted/60 font-sans">→</span>
      </a>
      <a href="/#reviews" class="mobile-nav-link py-2 text-xl font-serif text-charcoal hover:text-gold-deep transition-colors flex items-center justify-between border-b border-gold-border/15">
        <span>Client Reviews</span>
        <span class="text-xs text-muted/60 font-sans">4.9 ★ →</span>
      </a>
      <a href="/#contact" class="mobile-nav-link py-2 text-xl font-serif text-charcoal hover:text-gold-deep transition-colors flex items-center justify-between">
        <span>Find Studio & Hours</span>
        <span class="text-xs text-muted/60 font-sans">→</span>
      </a>
    </div>

    <!-- Mobile Drawer Footer -->
    <div class="pt-4 pb-4 border-t border-gold-border/40 flex flex-col gap-3.5 mt-auto">
      <div class="space-y-0.5">
        <p class="text-xs font-semibold text-charcoal uppercase tracking-wider">Angels Beauty Parlour & Bridal</p>
        <p class="text-xs text-muted leading-relaxed">{SITE_CONFIG.address.full}</p>
        <p class="text-xs text-gold-deep font-semibold pt-0.5">Open All Days • 9:00 AM to 8:00 PM</p>
      </div>

      <div class="grid grid-cols-2 gap-2.5 pt-1">
        <a 
          href={`tel:${SITE_CONFIG.contact.phoneTel}`} 
          class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl border border-gold-border text-xs font-semibold uppercase tracking-wider text-charcoal bg-surface hover:bg-surface-hover transition-colors"
        >
          <svg class="w-3.5 h-3.5 text-gold-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>Call Salon</span>
        </a>
        <a 
          href="/#booking" 
          class="mobile-nav-link flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl text-xs font-semibold uppercase tracking-wider text-charcoal bg-gold hover:bg-gold-hover transition-colors shadow-xs"
        >
          <span>Book Now</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const container = document.getElementById('header-container');
  const header = document.getElementById('site-header');
  const trigger = document.getElementById('mobile-menu-trigger');
  const drawer = document.getElementById('mobile-menu-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  // Handle scroll transition: Edge-to-edge docked on mobile, floating rounded-2xl on desktop
  function handleScroll() {
    if (window.scrollY > 25) {
      container?.classList.add('sm:px-6', 'sm:pt-3');
      container?.classList.remove('px-0', 'pt-0');

      header?.classList.add(
        'sm:max-w-6xl',
        'sm:mx-auto',
        'sm:rounded-2xl',
        'bg-canvas/96',
        'backdrop-blur-xl',
        'border-b',
        'sm:border',
        'border-gold-border/60',
        'shadow-md',
        'shadow-charcoal/5',
        'py-2.5',
        'sm:py-3',
        'px-4',
        'sm:px-6'
      );
      header?.classList.remove('bg-transparent', 'border-transparent', 'py-3.5', 'sm:py-5', 'px-4', 'sm:px-8', 'lg:px-12');
    } else {
      container?.classList.remove('sm:px-6', 'sm:pt-3');
      container?.classList.add('px-0', 'pt-0');

      header?.classList.remove(
        'sm:max-w-6xl',
        'sm:mx-auto',
        'sm:rounded-2xl',
        'bg-canvas/96',
        'backdrop-blur-xl',
        'border-b',
        'sm:border',
        'border-gold-border/60',
        'shadow-md',
        'shadow-charcoal/5',
        'py-2.5',
        'sm:py-3',
        'px-4',
        'sm:px-6'
      );
      header?.classList.add('bg-transparent', 'border-transparent', 'py-3.5', 'sm:py-5', 'px-4', 'sm:px-8', 'lg:px-12');
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  function toggleMenu() {
    const isExpanded = trigger?.getAttribute('aria-expanded') === 'true';
    trigger?.setAttribute('aria-expanded', String(!isExpanded));
    drawer?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
    document.body.classList.toggle('overflow-hidden', !isExpanded);
  }

  trigger?.addEventListener('click', toggleMenu);

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (!drawer?.classList.contains('hidden')) {
        toggleMenu();
      }
    });
  });
</script>
