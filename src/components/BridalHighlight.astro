---
import { BRIDAL_PACKAGES, getWhatsAppBookingUrl } from '../config/site';
---

<section class="py-14 sm:py-18 lg:py-20 bg-surface/50 border-b border-black/[0.06] relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Title & Narrative -->
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-10 space-y-3 sm:space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white border border-black/[0.08] shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-charcoal"></span>
        <span class="text-[10px] sm:text-[11px] font-sans font-semibold tracking-[0.25em] uppercase text-charcoal/80">
          Bespoke Bridal Couture
        </span>
      </div>
      
      <h2 class="packages-heading-reveal text-3xl sm:text-5xl md:text-6xl font-serif text-charcoal tracking-tight leading-[1.12]">
        <span class="bridal-word inline-block opacity-40 text-charcoal/60 will-change-[opacity,transform,color]">Ceremonial</span>{" "}
        <span class="bridal-word inline-block opacity-40 text-charcoal/60 will-change-[opacity,transform,color]">Packages</span> <br class="hidden sm:inline" />
        <span class="italic font-normal font-serif">
          <span class="bridal-word inline-block opacity-40 text-charcoal/60 will-change-[opacity,transform,color]">Tailored</span>{" "}
          <span class="bridal-word inline-block opacity-40 text-charcoal/60 will-change-[opacity,transform,color]">to</span>{" "}
          <span class="bridal-word inline-block opacity-40 text-charcoal/60 will-change-[opacity,transform,color]">Your</span>{" "}
          <span class="bridal-word inline-block opacity-40 text-charcoal/60 will-change-[opacity,transform,color]">Vision</span>
        </span>
      </h2>

      <p class="text-muted text-xs sm:text-sm md:text-base font-sans leading-relaxed max-w-2xl mx-auto">
        From intimate morning church ceremonies in the hills of Wayanad to grand evening celebrations, explore our six signature bridal formulations crafted for camera-ready perfection.
      </p>
    </div>

    <!-- Package Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {BRIDAL_PACKAGES.map((pkg, index) => {
        const waUrl = getWhatsAppBookingUrl({ packageName: pkg.name });
        const formattedIndex = String(index + 1).padStart(2, '0');

        return (
          <div class="bridal-package-card luxury-card-hover relative rounded-[28px] sm:rounded-3xl p-6 sm:p-8 transition-all duration-300 flex flex-col justify-between group overflow-hidden bg-white border border-black/[0.08] hover:border-gold/50 shadow-[0_4px_20px_-4px_rgba(34,28,24,0.04)] hover:shadow-[0_16px_36px_-8px_rgba(158,123,53,0.12)]">
            {/* Delicate Luxury Gold Hairline Accent */}
            <div class="card-gold-hairline absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-gold to-transparent pointer-events-none" />
            
            <div>
              <!-- Header Bar: Serial + Minimalist Badge -->
              <div class="flex items-center justify-between mb-4">
                <span class="text-[10px] sm:text-[11px] font-sans font-medium tracking-[0.2em] text-muted">
                  № {formattedIndex}
                </span>

                {pkg.featured && (
                  <span class="px-3 py-1 rounded-full text-[9px] sm:text-[10px] font-sans font-semibold uppercase tracking-[0.18em] bg-charcoal text-white shadow-2xs">
                    Most Requested
                  </span>
                )}
              </div>

              <!-- Package Name & Tagline -->
              <h3 class="font-serif text-2xl sm:text-3xl text-charcoal font-normal tracking-tight mb-1.5 group-hover:text-black transition-colors">
                {pkg.name}
              </h3>
              <p class="text-xs sm:text-[13px] font-sans text-muted italic mb-4">
                {pkg.tagline}
              </p>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-muted/90 font-sans leading-relaxed mb-6">
                {pkg.description}
              </p>

              <!-- Inclusions Bullets -->
              <div class="space-y-3 pt-5 border-t border-black/[0.06]">
                <span class="text-[10px] font-sans uppercase tracking-[0.2em] text-charcoal/70 font-semibold block">
                  Artistry Inclusions
                </span>
                <ul class="space-y-2 text-xs font-sans text-charcoal/90">
                  {pkg.highlights.map((h) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-charcoal/40 mt-0.5 text-xs">✦</span>
                      <span class="leading-relaxed">{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Recommendation tag -->
              <div class="mt-6 pt-4 border-t border-black/[0.04] text-[11px] font-sans text-muted">
                <span class="font-semibold text-charcoal">Couture Fit:</span> {pkg.recommendedFor}
              </div>
            </div>

            <!-- Booking Action: Solid Black/Charcoal Background with Crisp White Writings -->
            <div class="pt-6 mt-6 border-t border-black/[0.06]">
              <a 
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-luxury-shimmer w-full py-3.5 px-5 rounded-full text-xs font-sans font-medium tracking-wide flex items-center justify-center gap-2.5 transition-all duration-300 active:scale-97 shadow-xs hover:shadow-md bg-charcoal hover:bg-black text-white group/btn cursor-pointer"
                aria-label={`Enquire & Book ${pkg.name} on WhatsApp`}
              >
                <svg class="w-4 h-4 fill-current text-[#25D366] group-hover/btn:scale-110 transition-transform shrink-0" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
                <span class="text-white font-medium">Book on WhatsApp</span>
              </a>
            </div>

          </div>
        );
      })}
    </div>

    <!-- View Full Bridal Page Link -->
    <div class="mt-12 sm:mt-16 text-center">
      <a 
        href="/bridal" 
        class="btn-luxury-shimmer inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-xs font-sans font-semibold uppercase tracking-wider bg-white hover:bg-neutral-50 text-charcoal border border-black/[0.08] hover:border-black/25 transition-all shadow-2xs hover:shadow-xs group"
      >
        <span>Discover Our Complete 3-Step Bridal Consultation Flow</span>
        <span class="text-charcoal/70 transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

  </div>
</section>
