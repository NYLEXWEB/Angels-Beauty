---
import { BRIDAL_PACKAGES, getWhatsAppBookingUrl } from '../config/site';
---

<section class="py-14 sm:py-20 md:py-28 bg-surface border-b border-gold-border/30 relative overflow-x-clip">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title & Narrative -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16 space-y-3 sm:space-y-4">
      <span class="text-[11px] sm:text-xs font-sans font-semibold tracking-[0.25em] uppercase text-gold-deep block">
        Bespoke Bridal Couture
      </span>
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-serif text-charcoal tracking-tight">
        Ceremonial Packages Tailored to Your Vision
      </h2>
      <p class="text-muted text-xs sm:text-base font-sans leading-relaxed">
        From subtle daytime church ceremonies in the hills of Wayanad to grand evening receptions, explore our six signature bridal formulations crafted for flawless longevity.
      </p>
    </div>

    <!-- Package Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-8">
      {BRIDAL_PACKAGES.map((pkg) => {
        const waUrl = getWhatsAppBookingUrl({ packageName: pkg.name });

        return (
          <div class={`relative rounded-2xl sm:rounded-3xl p-5 sm:p-8 transition-all duration-300 flex flex-col justify-between ${
            pkg.featured 
              ? 'bg-canvas border-2 border-gold shadow-md sm:shadow-lg ring-1 ring-gold/20' 
              : 'bg-canvas/80 hover:bg-canvas border border-gold-border/60 hover:border-gold hover:shadow-md'
          }`}>
            
            <div>
              <!-- Featured Badge -->
              {pkg.featured && (
                <div class="inline-block mb-3 px-2.5 py-0.5 rounded-full text-[9px] sm:text-[10px] font-sans font-semibold uppercase tracking-widest bg-gold text-charcoal">
                  Most Requested Choice
                </div>
              )}

              <!-- Header -->
              <h3 class="font-serif text-xl sm:text-2xl md:text-[1.65rem] text-charcoal font-medium mb-1">
                {pkg.name}
              </h3>
              <p class="text-xs font-sans text-gold-deep italic mb-3 sm:mb-4">
                {pkg.tagline}
              </p>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-muted font-sans leading-relaxed mb-5 sm:mb-6">
                {pkg.description}
              </p>

              <!-- Inclusions Bullets -->
              <div class="space-y-2 pt-3 sm:pt-4 border-t border-gold-border/30">
                <span class="text-[9px] sm:text-[10px] font-sans uppercase tracking-[0.2em] text-subtle font-semibold block">
                  Package Elements
                </span>
                <ul class="space-y-1.5 sm:space-y-2 text-xs text-charcoal/90 font-sans">
                  {pkg.highlights.map((h) => (
                    <li class="flex items-start gap-2">
                      <span class="text-gold-deep mt-0.5 font-bold">✓</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Recommendation tag -->
              <div class="mt-4 sm:mt-6 pt-3 border-t border-gold-border/20 text-[10px] sm:text-[11px] text-muted font-sans">
                <span class="font-medium text-charcoal">Ideal for:</span> {pkg.recommendedFor}
              </div>
            </div>

            <!-- Booking Action -->
            <div class="pt-5 sm:pt-6 mt-4 sm:mt-6 border-t border-gold-border/30">
              <a 
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full py-3 px-4 rounded-full text-xs font-sans font-semibold uppercase tracking-wider flex items-center justify-center gap-2 transition-all duration-300 active:scale-98 ${
                  pkg.featured
                    ? 'bg-gold hover:bg-gold-hover text-charcoal shadow-sm'
                    : 'border border-gold text-charcoal hover:bg-gold/15'
                }`}
                aria-label={`Enquire & Book ${pkg.name} on WhatsApp`}
              >
                <span>Book on WhatsApp</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>

          </div>
        );
      })}
    </div>

    <!-- View Full Bridal Page Link -->
    <div class="mt-10 sm:mt-14 text-center">
      <a 
        href="/bridal" 
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-sans font-semibold uppercase tracking-wider text-charcoal hover:text-gold-deep border-b-2 border-gold-deep pb-1 transition-colors"
      >
        <span>Discover Our Complete 3-Step Bridal Consultation Flow</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>
