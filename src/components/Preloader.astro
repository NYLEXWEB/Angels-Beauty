---
/**
 * Minimalist Haute-Couture Preloader for Angels Beauty Parlour
 * 
 * Strict Features:
 * - Runs ONLY on initial session entry (never on page navigation or browser back button)
 * - Complete asset decoding (GPU memory decode for images, buffer readyState for videos)
 * - Accurate real-time percentage counter (0% to 100%) and hairline gold progress track
 * - Instant zero-flash dismissal on back navigation or subpage traversal
 */
---

<div 
  id="angels-preloader" 
  class="fixed inset-0 z-[99999] flex flex-col items-center justify-center bg-[#FAF8F5] text-charcoal select-none overflow-hidden transition-all duration-700 ease-out"
  aria-label="Loading Angels Beauty Parlour"
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <!-- Ambient Luxury Warm Glow -->
  <div class="absolute w-[32rem] h-[32rem] bg-gold/10 rounded-full blur-3xl pointer-events-none -top-20 -left-20 animate-pulse"></div>
  <div class="absolute w-[28rem] h-[28rem] bg-gold/8 rounded-full blur-3xl pointer-events-none -bottom-20 -right-20"></div>

  <div class="relative z-10 flex flex-col items-center max-w-sm px-6 text-center">

    <!-- Brand Emblem with Breathing Gold Halo -->
    <div class="relative mb-6 sm:mb-7 group">
      <!-- Outer subtle rotating gold dash halo -->
      <div class="absolute -inset-2.5 rounded-full border border-gold/30 border-dashed animate-[spin_20s_linear_infinite] pointer-events-none"></div>
      
      <!-- Inner glowing circle -->
      <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full p-1 bg-white border border-gold/40 shadow-[0_8px_24px_rgba(158,123,53,0.15)] flex items-center justify-center overflow-hidden">
        <img 
          src="/images/logo.png" 
          alt="Angels Beauty Parlour Emblem" 
          class="w-full h-full object-cover rounded-full" 
          width="96" 
          height="96"
          loading="eager"
        />
      </div>
    </div>

    <!-- Luxury Haute-Couture Typography -->
    <h2 class="font-serif text-2xl sm:text-3xl font-light tracking-[0.25em] uppercase text-charcoal leading-none">
      Angels
    </h2>
    <p class="font-sans text-[9px] sm:text-[10px] tracking-[0.32em] uppercase text-gold-deep font-semibold mt-2 leading-tight">
      Beauty & Bridal Studio
    </p>
    <span class="font-sans text-[8px] sm:text-[9px] tracking-[0.24em] uppercase text-muted/65 mt-1 block">
      Mananthavady · Wayanad
    </span>

    <!-- Elegant Tabular Percentage Counter -->
    <div 
      id="preloader-counter" 
      class="font-sans text-xs sm:text-sm font-medium tracking-[0.22em] text-charcoal/85 tabular-nums mt-7 sm:mt-8"
    >
      0%
    </div>

    <!-- Hairline Gold Progress Bar -->
    <div class="w-44 sm:w-56 h-[2px] bg-black/[0.07] rounded-full overflow-hidden relative mt-2.5 shadow-2xs">
      <div 
        id="preloader-bar" 
        class="h-full w-0 bg-gradient-to-r from-gold-deep via-gold to-gold-light rounded-full transition-all duration-100 ease-out shadow-[0_0_10px_rgba(158,123,53,0.5)]"
      ></div>
    </div>

    <!-- Contextual Status Message -->
    <p 
      id="preloader-status" 
      class="text-[9px] sm:text-[10px] font-sans tracking-[0.22em] uppercase text-muted/60 mt-3.5 h-4 transition-opacity duration-300"
    >
      Initializing Artistry...
    </p>

  </div>
</div>

<script is:inline>
(function() {
  const SESSION_KEY = 'angels_visited_session';
  const preloader = document.getElementById('angels-preloader');
  if (!preloader) return;

  // 1. Immediate Session Check: Never show on subsequent pages or back navigation
  if (sessionStorage.getItem(SESSION_KEY)) {
    preloader.style.display = 'none';
    preloader.remove();
    return;
  }

  // Lock background scroll during initial load
  document.body.style.overflow = 'hidden';

  const counterEl = document.getElementById('preloader-counter');
  const barEl = document.getElementById('preloader-bar');
  const statusEl = document.getElementById('preloader-status');

  // Critical Above-The-Fold Assets
  const CRITICAL_ASSETS = [
    '/images/logo.png',
    '/images/hero-bg.jpg'
  ];

  // Secondary Visual Assets
  const SECONDARY_ASSETS = [
    '/images/bridal-church.jpg',
    '/images/bridal-room.jpg',
    '/images/bridal-suite.jpg',
    '/images/pedicure-spa.jpg',
    '/images/skin-hair-lounge.jpg',
    '/images/styling-aisle.jpg',
    '/images/services/bridal-makeup.jpg',
    '/images/services/hd-bridal-makeup.jpg',
    '/images/services/glass-skin-bridal.jpg',
    '/images/services/airbrush-bridal.jpg',
    '/images/services/bridal-hair-styling.jpg',
    '/images/services/bridal-saree-draping.jpg',
    '/images/services/reception-makeup.jpg',
    '/images/services/hair-highlights.jpg',
    '/images/services/keratin-treatment.jpg',
    '/images/services/korean-facial.jpg'
  ];

  let criticalLoaded = 0;
  let secondaryLoaded = 0;
  let targetProgress = 15;
  let currentProgress = 0;
  let isFinished = false;

  function updateTarget() {
    const critRatio = criticalLoaded / CRITICAL_ASSETS.length; // 0 to 1
    const secRatio = SECONDARY_ASSETS.length > 0 ? (secondaryLoaded / SECONDARY_ASSETS.length) : 1;
    // Critical assets weight 60%, secondary assets weight 40%
    const calculated = Math.round((critRatio * 60) + (secRatio * 40));
    targetProgress = Math.min(100, Math.max(targetProgress, calculated));
  }

  // Step A: Preload and Decode Critical Assets First
  CRITICAL_ASSETS.forEach(url => {
    const img = new Image();
    img.src = url;
    if (typeof img.decode === 'function') {
      img.decode()
        .then(() => {
          criticalLoaded++;
          updateTarget();
        })
        .catch(() => {
          criticalLoaded++;
          updateTarget();
        });
    } else {
      img.onload = () => {
        criticalLoaded++;
        updateTarget();
      };
      img.onerror = () => {
        criticalLoaded++;
        updateTarget();
      };
    }
  });

  // Step B: Fonts Readiness
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(() => {
      targetProgress = Math.max(targetProgress, 35);
    });
  }

  // Step C: Decode Secondary Visuals in Background
  SECONDARY_ASSETS.forEach(url => {
    const img = new Image();
    img.src = url;
    if (typeof img.decode === 'function') {
      img.decode()
        .then(() => {
          secondaryLoaded++;
          updateTarget();
        })
        .catch(() => {
          secondaryLoaded++;
          updateTarget();
        });
    } else {
      img.onload = () => {
        secondaryLoaded++;
        updateTarget();
      };
      img.onerror = () => {
        secondaryLoaded++;
        updateTarget();
      };
    }
  });

  // Step D: Prepare First Video Reel Metadata (Ready for immediate playback without downloading full video)
  const firstVideo = document.querySelector('video.reel-video');
  if (firstVideo) {
    if (firstVideo.readyState >= 1) { // HAVE_METADATA or higher
      targetProgress = Math.max(targetProgress, 50);
    } else {
      firstVideo.addEventListener('loadedmetadata', () => {
        targetProgress = Math.max(targetProgress, 50);
      }, { once: true });
    }
  }

  // Step E: Adaptive Progress Boost (Ensures smooth, steady advance without stalling)
  const steadyTimer = setInterval(() => {
    if (targetProgress < 95) {
      targetProgress = Math.min(95, targetProgress + 8);
    }
  }, 120);

  // Safety Fallback: Guarantee website opens within 2.2 seconds maximum on any connection
  const safetyTimeout = setTimeout(function() {
    targetProgress = 100;
  }, 2200);

  // Step F: Fluid Haute-Couture Lerp Animation Loop
  function renderProgress() {
    if (isFinished) return;

    if (currentProgress < targetProgress) {
      const step = Math.max(1, Math.ceil((targetProgress - currentProgress) * 0.18));
      currentProgress = Math.min(targetProgress, currentProgress + step);
    }

    if (counterEl) counterEl.textContent = `${currentProgress}%`;
    if (barEl) barEl.style.width = `${currentProgress}%`;
    if (preloader) preloader.setAttribute('aria-valuenow', String(currentProgress));

    // Refined Editorial Status Labels
    if (statusEl) {
      if (currentProgress < 30) {
        statusEl.textContent = "Loading Haute Visuals...";
      } else if (currentProgress < 65) {
        statusEl.textContent = "Decoding Studio Imagery...";
      } else if (currentProgress < 90) {
        statusEl.textContent = "Preparing Cinematic Reels...";
      } else if (currentProgress < 100) {
        statusEl.textContent = "Refining Studio Ambience...";
      } else {
        statusEl.textContent = "Welcome to Angels Studio";
      }
    }

    // Completion Trigger
    if (currentProgress >= 100) {
      isFinished = true;
      clearInterval(steadyTimer);
      clearTimeout(safetyTimeout);
      setTimeout(dismissPreloader, 280);
      return;
    }

    requestAnimationFrame(renderProgress);
  }

  requestAnimationFrame(renderProgress);

  // Step G: Dismiss Preloader and Save Session State
  function dismissPreloader() {
    sessionStorage.setItem(SESSION_KEY, 'true');
    document.documentElement.classList.add('preloader-skipped');
    document.body.style.overflow = '';

    preloader.style.transition = 'opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1)';
    preloader.style.opacity = '0';
    preloader.style.transform = 'translateY(-12px) scale(1.008)';
    preloader.style.pointerEvents = 'none';

    setTimeout(function() {
      preloader.classList.add('is-done');
      preloader.remove();
      window.dispatchEvent(new CustomEvent('angels:ready'));
    }, 650);
  }

  // Step H: Support Back-Forward Cache (bfcache) navigation
  window.addEventListener('pageshow', function(e) {
    if (e.persisted || sessionStorage.getItem(SESSION_KEY)) {
      document.body.style.overflow = '';
      if (preloader && preloader.parentNode) {
        preloader.classList.add('is-done');
        preloader.remove();
      }
    }
  });

})();
</script>

<style>
  :global(html.preloader-skipped) #angels-preloader,
  #angels-preloader.is-done {
    display: none !important;
    pointer-events: none !important;
  }
</style>
