---
/**
 * Master Haute-Couture Preloader for Angels Beauty Parlour & Bridal Studio
 * 
 * Strict Performance & UX Features:
 * - Appears ONLY on first website entrance in a session or on manual page reload (F5 / Refresh)
 * - Internal page transitions (Services, Bridal, Gallery, etc.) skip preloader immediately with ZERO flash
 * - Smooth lerp percentage counter (0% to 100%) tracking actual image readiness
 * - Instant scroll unlock and trigger of hero entrance sequence
 */
---

<div 
  id="angels-preloader" 
  class="fixed inset-0 z-[999999] flex flex-col items-center justify-center bg-[#FAF8F5] text-charcoal select-none overflow-hidden transition-all duration-700 ease-out"
  aria-label="Loading Angels Beauty Parlour"
  role="progressbar"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <!-- Ambient Luxury Warm Glow -->
  <div class="absolute w-[32rem] h-[32rem] bg-gold/15 rounded-full blur-3xl pointer-events-none -top-16 -left-16 animate-pulse"></div>
  <div class="absolute w-[28rem] h-[28rem] bg-gold/10 rounded-full blur-3xl pointer-events-none -bottom-16 -right-16"></div>

  <div class="relative z-10 flex flex-col items-center max-w-sm px-6 text-center">

    <!-- Brand Emblem with Breathing Gold Halo -->
    <div class="relative mb-6 group">
      <!-- Outer subtle rotating gold dash halo -->
      <div class="absolute -inset-2.5 rounded-full border border-gold/40 border-dashed animate-[spin_12s_linear_infinite] pointer-events-none"></div>
      
      <!-- Inner glowing circle -->
      <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full p-1 bg-white border border-gold/40 shadow-[0_8px_24px_rgba(158,123,53,0.18)] flex items-center justify-center overflow-hidden">
        <img 
          src="/images/logo.webp" 
          alt="Angels Beauty Parlour Emblem" 
          class="w-full h-full object-cover rounded-full" 
          width="96" 
          height="96"
          loading="eager"
        />
      </div>
    </div>

    <!-- Luxury Haute-Couture Typography -->
    <h2 class="font-serif text-2xl sm:text-3xl font-light tracking-[0.25em] uppercase text-charcoal leading-none">
      Angels
    </h2>
    <p class="font-sans text-[9px] sm:text-[10px] tracking-[0.32em] uppercase text-gold-deep font-semibold mt-2.5 leading-tight">
      Beauty & Bridal Studio
    </p>
    <span class="font-sans text-[8px] sm:text-[9px] tracking-[0.24em] uppercase text-muted/65 mt-1 block">
      Mananthavady · Wayanad
    </span>

    <!-- Elegant Tabular Percentage Counter -->
    <div 
      id="preloader-counter" 
      class="font-sans text-xs sm:text-sm font-medium tracking-[0.22em] text-charcoal/85 tabular-nums mt-7"
    >
      0%
    </div>

    <!-- Hairline Gold Progress Bar Track -->
    <div class="w-48 sm:w-56 h-[2.5px] bg-black/[0.08] rounded-full overflow-hidden relative mt-2.5 shadow-2xs">
      <div 
        id="preloader-bar" 
        class="h-full w-0 bg-gradient-to-r from-gold-deep via-gold to-gold-light rounded-full transition-all duration-75 ease-out shadow-[0_0_12px_rgba(201,166,107,0.7)]"
      ></div>
    </div>

    <!-- Dynamic Status Label -->
    <p 
      id="preloader-status" 
      class="text-[9px] sm:text-[10px] font-sans tracking-[0.22em] uppercase text-muted/70 mt-3.5 h-4 transition-opacity duration-200"
    >
      Decoding Studio Imagery...
    </p>

  </div>
</div>

<script is:inline>
(function() {
  const preloader = document.getElementById('angels-preloader');
  if (!preloader) return;

  // Determine if this is a first-time visit or a manual page reload (F5)
  let isSkip = document.documentElement.classList.contains('skip-preloader');
  if (!isSkip) {
    try {
      const navEntries = window.performance && performance.getEntriesByType && performance.getEntriesByType('navigation');
      const isReload = (navEntries && navEntries[0] && navEntries[0].type === 'reload') || (window.performance && window.performance.navigation && window.performance.navigation.type === 1);
      const hasVisited = sessionStorage.getItem('angels_session_visited');
      if (hasVisited && !isReload) {
        isSkip = true;
      }
    } catch (e) {}
  }

  // If internal page navigation, dismiss immediately with ZERO delay
  if (isSkip) {
    preloader.style.display = 'none';
    preloader.remove();
    document.body.style.overflow = '';
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        window.dispatchEvent(new CustomEvent('angels:ready'));
      }, { once: true });
    } else {
      window.dispatchEvent(new CustomEvent('angels:ready'));
    }
    return;
  }

  // Handle bfcache back-forward navigation
  window.addEventListener('pageshow', function(event) {
    if (event.persisted) {
      document.body.style.overflow = '';
      if (preloader && preloader.parentNode) preloader.remove();
      window.dispatchEvent(new CustomEvent('angels:ready'));
    }
  });

  // Lock scroll cleanly while loading
  document.body.style.overflow = 'hidden';

  const counterEl = document.getElementById('preloader-counter');
  const barEl = document.getElementById('preloader-bar');
  const statusEl = document.getElementById('preloader-status');

  // Key Photography Assets to decode
  const CORE_IMAGES = [
    '/images/logo.webp',
    '/images/hero-bg.webp',
    '/images/bridal-church.webp',
    '/images/bridal-room.webp',
    '/images/bridal-suite.webp',
    '/images/pedicure-spa.webp',
    '/images/skin-hair-lounge.webp',
    '/images/styling-aisle.webp'
  ];

  const imageSet = new Set(CORE_IMAGES);
  try {
    const pageImgs = document.querySelectorAll('img');
    pageImgs.forEach(function(img) {
      const src = img.getAttribute('src');
      if (src && !src.startsWith('data:') && !src.endsWith('.svg')) {
        imageSet.add(src);
      }
    });
  } catch (e) {}

  const ALL_IMAGES = Array.from(imageSet);
  const totalImages = ALL_IMAGES.length;
  let loadedImages = 0;
  let targetProgress = 12;
  let currentProgress = 0;
  let isDone = false;

  function onImageDone() {
    loadedImages++;
    const rawProgress = Math.round((loadedImages / totalImages) * 100);
    targetProgress = Math.max(targetProgress, Math.min(100, rawProgress));
    if (loadedImages >= totalImages) {
      targetProgress = 100;
    }
  }

  // Preload and GPU-Decode Critical Images
  ALL_IMAGES.forEach(function(url) {
    const img = new Image();
    img.src = url;

    if (typeof img.decode === 'function') {
      img.decode()
        .then(onImageDone)
        .catch(function() {
          if (img.complete) {
            onImageDone();
          } else {
            img.onload = onImageDone;
            img.onerror = onImageDone;
          }
        });
    } else {
      if (img.complete) {
        onImageDone();
      } else {
        img.onload = onImageDone;
        img.onerror = onImageDone;
      }
    }
  });

  // Fonts Readiness Check
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(function() {
      targetProgress = Math.max(targetProgress, 25);
    });
  }

  // Safety Timeout (2.5s safeguard so user is never stalled even on slow connection)
  const emergencyTimeout = setTimeout(function() {
    targetProgress = 100;
    loadedImages = totalImages;
  }, 2500);

  // Smooth Haute-Couture Lerp Animation Loop
  function renderProgress() {
    if (isDone) return;

    if (currentProgress < targetProgress) {
      const step = Math.max(1, Math.ceil((targetProgress - currentProgress) * 0.22));
      currentProgress = Math.min(targetProgress, currentProgress + step);
    }

    if (counterEl) counterEl.textContent = currentProgress + '%';
    if (barEl) barEl.style.width = currentProgress + '%';
    if (preloader) preloader.setAttribute('aria-valuenow', String(currentProgress));

    // Refined Editorial Status Labels
    if (statusEl) {
      if (currentProgress < 30) {
        statusEl.textContent = 'Decoding Studio Atmosphere...';
      } else if (currentProgress < 65) {
        statusEl.textContent = 'Preloading Bridal Collections...';
      } else if (currentProgress < 90) {
        statusEl.textContent = 'Preparing High-Resolution Gallery...';
      } else if (currentProgress < 100) {
        statusEl.textContent = 'Perfecting Studio Ambience...';
      } else {
        statusEl.textContent = 'Welcome to Angels Studio';
      }
    }

    if (currentProgress >= 100) {
      isDone = true;
      clearTimeout(emergencyTimeout);
      setTimeout(dismissPreloader, 180);
      return;
    }

    requestAnimationFrame(renderProgress);
  }

  requestAnimationFrame(renderProgress);

  // Dismiss Preloader and Reveal Website
  function dismissPreloader() {
    try {
      sessionStorage.setItem('angels_session_visited', 'true');
    } catch(e) {}

    document.body.style.overflow = '';

    preloader.style.transition = 'opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
    preloader.style.opacity = '0';
    preloader.style.transform = 'translateY(-20px) scale(1.01)';
    preloader.style.pointerEvents = 'none';

    setTimeout(function() {
      if (preloader && preloader.parentNode) {
        preloader.remove();
      }
      window.dispatchEvent(new CustomEvent('angels:ready'));
    }, 500);
  }

})();
</script>

<style>
  #angels-preloader {
    will-change: opacity, transform;
  }
</style>
