---

<section id="gallery" class="py-20 sm:py-28 lg:py-32 bg-canvas overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Minimalist Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 sm:mb-14">
      <div class="max-w-2xl space-y-2 sm:space-y-3">
        <span class="text-[11px] sm:text-xs font-sans font-semibold tracking-[0.25em] uppercase text-gold-deep block">
          Portfolio & Real Brides
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-light text-charcoal tracking-[-0.03em] leading-tight">
          Bespoke Bridal Gallery
        </h2>
        <p class="text-muted text-xs sm:text-base font-sans leading-relaxed max-w-xl">
          An authentic showcase of real brides styled by Angels Beauty Parlour in Mananthavady — from heirloom South Indian silks to Christian gowns and contemporary lehengas.
        </p>
      </div>

      <!-- Minimalist Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 shrink-0 pt-2 md:pt-0" id="gallery-filters">
        <button 
          type="button" 
          data-filter="all" 
          class="gallery-filter-btn px-4 sm:px-5 py-2 rounded-full text-xs font-medium tracking-tight transition-all duration-200 cursor-pointer bg-charcoal text-white shadow-2xs"
        >
          All (15)
        </button>
        <button 
          type="button" 
          data-filter="traditional" 
          class="gallery-filter-btn px-4 sm:px-5 py-2 rounded-full text-xs font-medium tracking-tight transition-all duration-200 cursor-pointer bg-surface hover:bg-gold/15 text-charcoal/80 border border-black/[0.06]"
        >
          Traditional Saree
        </button>
        <button 
          type="button" 
          data-filter="christian" 
          class="gallery-filter-btn px-4 sm:px-5 py-2 rounded-full text-xs font-medium tracking-tight transition-all duration-200 cursor-pointer bg-surface hover:bg-gold/15 text-charcoal/80 border border-black/[0.06]"
        >
          Christian Bridal
        </button>
        <button 
          type="button" 
          data-filter="lehenga" 
          class="gallery-filter-btn px-4 sm:px-5 py-2 rounded-full text-xs font-medium tracking-tight transition-all duration-200 cursor-pointer bg-surface hover:bg-gold/15 text-charcoal/80 border border-black/[0.06]"
        >
          Lehenga & Reception
        </button>
      </div>
    </div>

    <!-- Aesthetic Responsive Photography Grid (100% Pure Images - Zero Text Overlays) -->
    <div 
      id="gallery-grid" 
      class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-3.5 sm:gap-6 lg:gap-8"
    >
      {GALLERY_PHOTOS.map((photo, index) => (
        <div 
          class="gallery-item group relative aspect-[3/4] rounded-2xl sm:rounded-3xl overflow-hidden bg-surface border border-black/[0.06] shadow-xs hover:shadow-xl transition-all duration-500 cursor-pointer"
          data-category={photo.category}
          data-index={index}
          data-src={photo.src}
          data-alt={photo.alt}
          tabindex="0"
          role="button"
          aria-label={photo.alt}
        >
          {/* Pure Pristine Photo - NO WRITING, NO LABELS, NO GRADIENT OVERLAY */}
          <img 
            src={photo.src} 
            alt={photo.alt}
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            loading="eager"
            decoding="async"
            width="600"
            height="800"
          />
        </div>
      ))}
    </div>

  </div>

  <!-- Fullscreen Bridal Lightbox Modal with Dedicated Top Close Bar -->
  <div 
    id="gallery-lightbox" 
    class="fixed inset-0 z-[999999] bg-black/95 backdrop-blur-2xl flex items-center justify-center p-3 sm:p-6 md:p-8 hidden opacity-0 transition-opacity duration-300 select-none"
    role="dialog"
    aria-modal="true"
    aria-label="Bridal Gallery Lightbox"
  >
    <!-- Dedicated Top Close Bar (Prominent and impossible to miss) -->
    <div class="fixed top-0 inset-x-0 z-30 bg-black/85 backdrop-blur-xl border-b border-white/15 px-4 sm:px-8 py-3.5 flex items-center justify-between pointer-events-auto">
      <div class="flex items-center gap-2.5 sm:gap-3">
        <span class="w-2 h-2 rounded-full bg-gold-deep animate-pulse"></span>
        <span class="text-xs sm:text-sm font-sans tracking-wide text-white/90 font-medium">Angels Bridal Gallery</span>
        <span class="text-white/30 hidden xs:inline">·</span>
        <div class="px-2.5 py-0.5 rounded-full bg-white/10 text-gold-light text-xs font-sans tracking-wider border border-white/10">
          <span id="lightbox-counter">1 / 15</span>
        </div>
      </div>
      
      <!-- Prominent Close Bar Button -->
      <button 
        id="lightbox-close" 
        class="inline-flex items-center gap-2 px-4 py-1.5 sm:px-5 sm:py-2 rounded-full bg-white/15 hover:bg-white/25 active:bg-white/35 text-white border border-white/25 text-xs font-sans font-semibold uppercase tracking-wider transition-all active:scale-95 cursor-pointer shadow-lg"
        aria-label="Close Lightbox"
      >
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>Close</span>
      </button>
    </div>

    <!-- Navigation Arrow: Previous -->
    <button 
      id="lightbox-prev"
      class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all cursor-pointer border border-white/15 z-20 shadow-2xl active:scale-95"
      aria-label="Previous Image"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Navigation Arrow: Next -->
    <button 
      id="lightbox-next"
      class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-white/10 hover:bg-white/25 text-white flex items-center justify-center transition-all cursor-pointer border border-white/15 z-20 shadow-2xl active:scale-95"
      aria-label="Next Image"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Center Image Container (Pure Image, No Text) -->
    <div class="relative max-w-4xl max-h-[82dvh] flex items-center justify-center z-10 pointer-events-none select-none pt-12">
      <img 
        id="lightbox-img" 
        src="" 
        alt="Enlarged bridal photo" 
        class="max-w-[92vw] max-h-[76dvh] object-contain rounded-2xl shadow-2xl border border-white/15 pointer-events-auto transition-transform duration-300"
      />
    </div>

    <!-- Mobile Bottom Quick Close Pill -->
    <div class="fixed bottom-4 inset-x-0 flex justify-center z-30 sm:hidden pointer-events-auto">
      <button 
        id="lightbox-bottom-close"
        class="inline-flex items-center gap-1.5 px-5 py-2 rounded-full bg-charcoal/90 text-white border border-white/20 text-xs font-sans tracking-wide uppercase shadow-xl active:scale-95"
      >
        <span>✕ Close Preview</span>
      </button>
    </div>
  </div>
</section>

<script>
  // Filter Functionality
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update button styles
      filterBtns.forEach(b => {
        b.classList.remove('bg-charcoal', 'text-white', 'shadow-2xs');
        b.classList.add('bg-surface', 'text-charcoal/80', 'border', 'border-black/[0.06]');
      });
      btn.classList.add('bg-charcoal', 'text-white', 'shadow-2xs');
      btn.classList.remove('bg-surface', 'text-charcoal/80', 'border-black/[0.06]');

      // Filter gallery cards
      galleryItems.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        if (filter === 'all' || itemCat === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Lightbox Functionality
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCounter = document.getElementById('lightbox-counter');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');

  // Collect visible items dynamically for lightbox navigation
  function getVisibleItems() {
    return Array.from(galleryItems).filter(item => (item as HTMLElement).style.display !== 'none');
  }

  let currentVisibleIndex = 0;

  function updateLightboxImage() {
    const visible = getVisibleItems();
    if (!visible.length || !lightboxImg || !lightboxCounter) return;
    
    if (currentVisibleIndex < 0) currentVisibleIndex = visible.length - 1;
    if (currentVisibleIndex >= visible.length) currentVisibleIndex = 0;

    const currentItem = visible[currentVisibleIndex];
    const src = currentItem.getAttribute('data-src') || '';
    const alt = currentItem.getAttribute('data-alt') || '';

    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightboxCounter.textContent = `${currentVisibleIndex + 1} / ${visible.length}`;
  }

  function openLightbox(item: Element) {
    if (!lightbox) return;

    // Teleport lightbox directly to body to avoid any parent transform or overflow restrictions
    if (lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }

    const visible = getVisibleItems();
    currentVisibleIndex = visible.indexOf(item);
    if (currentVisibleIndex === -1) currentVisibleIndex = 0;

    updateLightboxImage();

    lightbox.classList.remove('hidden');
    requestAnimationFrame(() => {
      lightbox.classList.remove('opacity-0');
      lightbox.classList.add('opacity-100');
    });
    document.body.classList.add('overflow-hidden');
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('opacity-0');
    lightbox.classList.remove('opacity-100');
    setTimeout(() => {
      lightbox.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }, 300);
  }

  const bottomCloseBtn = document.getElementById('lightbox-bottom-close');
  bottomCloseBtn?.addEventListener('click', closeLightbox);

  function showNext() {
    currentVisibleIndex++;
    updateLightboxImage();
  }

  function showPrev() {
    currentVisibleIndex--;
    updateLightboxImage();
  }

  galleryItems.forEach(item => {
    item.addEventListener('click', () => openLightbox(item));
    item.addEventListener('keydown', (e: any) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(item);
      }
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showPrev();
  });
  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showNext();
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  window.addEventListener('keydown', (e) => {
    if (lightbox && !lightbox.classList.contains('hidden')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    }
  });

  // Touch Swipe navigation on mobile
  let touchStartX = 0;
  let touchEndX = 0;

  lightbox?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  lightbox?.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    if (touchStartX - touchEndX > 50) {
      showNext();
    } else if (touchEndX - touchStartX > 50) {
      showPrev();
    }
  }, { passive: true });
</script>
