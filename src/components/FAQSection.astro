---
export interface FAQItem {
  question: string;
  answer: string;
}

export const HOME_FAQS: FAQItem[] = [
  {
    question: "What bridal makeup packages are available at Angels Beauty Parlour in Mananthavady?",
    answer: "We offer 6 bespoke bridal makeover packages tailored for Christian, Hindu, and Muslim wedding ceremonies across Wayanad: Normal Bridal, HD Bridal Makeup, UHD Bridal, Korean Glass Skin Bridal, Airbrush Bridal Makeup, and Signature Haute Couture Packages. Every package includes personalized skin prep, couture hair styling, jewelry setting, dupatta/saree draping, and access to our private, air-conditioned bridal dressing suite."
  },
  {
    question: "What is the difference between HD and Airbrush bridal makeup?",
    answer: "HD Bridal Makeup utilizes micro-fine, light-diffusing pigments that eliminate camera flashback and create a soft-focus satin finish for modern 4K wedding videography. Airbrush Bridal Makeup uses an atomized micro-mist that creates an ultra-lightweight, 100% waterproof and tear-resistant veil that stays immaculate through marathon ceremonies and humid Kerala climates."
  },
  {
    question: "Do you travel to wedding venues and resorts across Wayanad?",
    answer: "Yes! While many brides prefer our serene, private Bridal Suite at PP Building, Mananthavady, our certified bridal artistry team regularly travels to wedding halls, luxury resorts, and private residences across Wayanad, including Kalpetta, Sulthan Bathery, Vythiri, Meppadi, Panamaram, and surrounding regions."
  },
  {
    question: "How far in advance should I book my bridal appointment?",
    answer: "Due to high demand during Kerala wedding seasons (August–January and April–May), we recommend reserving your date 2 to 6 months in advance. We take limited bridal bookings per day to ensure complete, unhurried personal attention for each bride."
  },
  {
    question: "What hair smoothing and restoration treatments do you offer?",
    answer: "Our certified hair specialists offer advanced Hair Botox, Nanoplastia, Keratin Treatments, Biotin Therapy, and Anti-Frizz Hair Spa. We exclusively use premium, formaldehyde-safe formulations that nourish the hair cuticle while delivering silky, frizz-free results for 4 to 8 months."
  },
  {
    question: "What is the Korean Glass Skin Facial, and when should a bride get it?",
    answer: "The Korean Glass Skin treatment is a multi-step clinical hydra-infusion with peptides and hyaluronic serums that refines pores, evens tone, and imparts a luminous, dewy glow. We recommend scheduling this treatment 3 to 7 days before your wedding day or engagement for maximum radiance."
  },
  {
    question: "Where is Angels Beauty Parlour located and what are the opening hours?",
    answer: "We are centrally located at PP Building, Near St Joseph's Hospital, Mananthavady, Wayanad. We are open all 7 days a week from 9:00 AM to 8:00 PM with no weekly holidays. Ample vehicle parking is available."
  }
];

interface Props {
  title?: string;
  subtitle?: string;
  faqs?: FAQItem[];
}

const {
  title = "Frequently Asked Questions",
  subtitle = "Everything you need to know about bridal couture, salon services, and appointment bookings at Angels Beauty Studio in Wayanad.",
  faqs = HOME_FAQS
} = Astro.props;
---

<section 
  id="faq" 
  class="py-16 sm:py-24 bg-surface/60 border-t border-gold-border/25 relative overflow-hidden"
  aria-labelledby="faq-heading"
>
  <!-- Background Glow Accents -->
  <div class="absolute -top-32 -right-32 w-96 h-96 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-gold/40 bg-white/80 backdrop-blur-xs text-gold-deep text-[10px] sm:text-xs font-semibold tracking-widest uppercase mb-3 shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
        Client Guidance & FAQs
      </div>
      <h2 
        id="faq-heading" 
        class="font-display text-2xl sm:text-4xl md:text-5xl font-light text-charcoal tracking-tight leading-tight"
      >
        Frequently Asked <span class="italic font-normal text-gold-deep font-serif">Questions</span>
      </h2>
      <p class="mt-3 sm:mt-4 text-xs sm:text-sm text-muted font-sans leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-3.5 sm:space-y-4" role="region" aria-label="FAQ Accordion">
      {faqs.map((faq, index) => (
        <details 
          class="faq-accordion-item group bg-white/95 backdrop-blur-sm rounded-2xl border border-gold-border/40 hover:border-gold/60 shadow-2xs hover:shadow-xs transition-all duration-300 overflow-hidden"
          open={index === 0}
        >
          <summary class="flex items-center justify-between p-4 sm:p-5 text-left cursor-pointer select-none list-none gap-4">
            <span class="font-sans text-sm sm:text-base font-medium text-charcoal group-open:text-gold-deep transition-colors leading-snug">
              {faq.question}
            </span>
            <span class="shrink-0 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-surface border border-gold/30 flex items-center justify-center text-charcoal group-open:text-gold-deep group-open:rotate-180 transition-transform duration-300 shadow-2xs">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </span>
          </summary>
          <div class="px-4 pb-4 sm:px-5 sm:pb-5 pt-0 text-xs sm:text-sm text-muted font-sans leading-relaxed border-t border-gold-border/15 mt-1">
            <p class="pt-2">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Direct Consultation CTA Card -->
    <div class="mt-10 sm:mt-12 p-6 sm:p-8 rounded-2xl sm:rounded-3xl bg-white border border-gold/40 shadow-sm text-center flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="text-center sm:text-left">
        <h3 class="font-serif text-lg sm:text-xl font-medium text-charcoal">Have a specific bridal or skincare question?</h3>
        <p class="text-xs text-muted font-sans mt-0.5">Chat directly with our senior beauty artists on WhatsApp for instant guidance.</p>
      </div>
      <a 
        href="https://wa.me/918606248992?text=Hello%20Angels%20Beauty%20Studio%2C%20I%20have%20a%20question%20regarding%20your%20services"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 py-2.5 sm:py-3 rounded-full text-xs font-semibold uppercase tracking-wider bg-charcoal hover:bg-black text-white shadow-xs transition-all active:scale-97 shrink-0"
      >
        <svg class="w-4 h-4 fill-[#25D366] text-[#25D366]" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
        </svg>
        <span>Ask on WhatsApp</span>
      </a>
    </div>

  </div>
</section>

<style>
  /* Native smooth accordion toggle */
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
